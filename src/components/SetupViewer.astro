---
import type { Setup } from "../setups";
import Photo from "./Photo.astro";

interface Props {
  setup: Setup;
  /** The Setup's Event type as the site shows it, named above the caption. */
  eventType: string;
  /**
   * The viewer's element id. The page opens each viewer with a button that has `commandfor` set to this
   * id and `command="show-modal"`, which works without JavaScript.
   */
  id: string;
}

const { setup, eventType, id } = Astro.props;
const { caption, coverPhoto, photos } = setup.data;
const allPhotos = [coverPhoto, ...photos];
const total = allPhotos.length;
---

<!--
  A modal dialog keeps focus inside while open, closes on Escape, and hands focus back on close. It's the
  atelier wall: each photo hangs in a paper mat on deep sage, one at a time. The pieces sit flat in the
  dialog so the phone and desktop layouts can each place them on their own grid.
-->
<dialog class="setup-viewer" id={id} aria-labelledby={`${id}-caption`}>
  <header class="label">
    <p class="event-type">{eventType}</p>
    <h2 id={`${id}-caption`}>{caption}</h2>
  </header>
  <form method="dialog" class="close-form">
    <button type="submit" class="close wall-button" autofocus>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
      Close
    </button>
  </form>

  <!-- One photo per screen: swiping is the browser's own scroll, settling on each photo. Focusable, so
  the arrow keys scroll it even without JavaScript. -->
  <ul class="track" aria-label="Photos" tabindex="0">
    {
      allPhotos.map((photo, index) => (
        <li>
          <Photo
            src={photo}
            alt={`${caption}, photo ${index + 1} of ${total}`}
            sizes="(min-width: 48rem) calc(100vw - 22rem), 100vw"
          />
        </li>
      ))
    }
  </ul>

  <!-- Kept up to date by the script, so shown only once it runs. Screen readers hear "Photo 3 of 9" as it changes. -->
  <p class="counter" role="status">
    <span aria-hidden="true"><span class="now">1</span><span class="of"> / {total}</span></span>
    <span class="visually-hidden">Photo <span class="now">1</span> of {total}</span>
  </p>

  <!-- Desktop only, beside the photo. -->
  <div class="steps">
    <button type="button" class="previous wall-button" disabled>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
      Previous<span class="visually-hidden"> photo</span>
    </button>
    <button type="button" class="next wall-button" disabled={total === 1}>
      Next<span class="visually-hidden"> photo</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <div class="thumbnails" role="group" aria-label="Jump to a photo">
    {
      allPhotos.map((photo, index) => (
        <button type="button" aria-current={index === 0 ? "true" : undefined}>
          <Photo src={photo} alt="" sizes="6rem" />
          <span class="visually-hidden">Photo {index + 1}</span>
        </button>
      ))
    }
  </div>
</dialog>

<script>
  import { milliseconds, reduceMotion, token } from "../motion";

  // An open viewer has its own history entry at the same URL, recording which viewer is open. So the
  // browser or phone back gesture closes it instead of leaving the page, and forward or a reload opens it again.
  interface ViewerEntry {
    setupViewer: string;
  }
  const viewerIn = (state: unknown) => (state as Partial<ViewerEntry> | null)?.setupViewer;

  const viewers = [...document.querySelectorAll<HTMLDialogElement>(".setup-viewer")];

  // The extras on top of the swipeable track: the counter, and on desktop the buttons, keys and thumbnails.
  // A viewer always opens on its cover, and closes back into its card only from there.
  const toCover = new Map<HTMLDialogElement, () => void>();
  const onCover = new Map<HTMLDialogElement, () => boolean>();
  for (const viewer of viewers) {
    const track = viewer.querySelector<HTMLElement>(".track")!;
    const slides = [...track.children];
    const counterNumbers = [...viewer.querySelectorAll<HTMLElement>(".counter .now")];
    const previous = viewer.querySelector<HTMLButtonElement>(".previous")!;
    const next = viewer.querySelector<HTMLButtonElement>(".next")!;
    const thumbnails = [...viewer.querySelectorAll<HTMLButtonElement>(".thumbnails button")];
    let current = 0;

    const show = (index: number) => {
      current = index;
      for (const number of counterNumbers) number.textContent = String(index + 1);
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      for (const thumbnail of thumbnails) thumbnail.removeAttribute("aria-current");
      thumbnails[index].setAttribute("aria-current", "true");
    };
    // Glides to the photo, or jumps under "reduce motion". The counter and buttons change straight away.
    const goTo = (index: number, smooth = !reduceMotion.matches) => {
      const photo = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: photo * track.clientWidth, behavior: smooth ? "smooth" : "instant" });
      show(photo);
    };
    toCover.set(viewer, () => goTo(0, false));
    onCover.set(viewer, () => current === 0);

    previous.addEventListener("click", () => goTo(current - 1));
    next.addEventListener("click", () => goTo(current + 1));
    thumbnails.forEach((thumbnail, index) => thumbnail.addEventListener("click", () => goTo(index)));
    // Held back from the browser, which would otherwise scroll the track a second time when it has focus.
    viewer.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") goTo(current - 1);
      else if (event.key === "ArrowRight") goTo(current + 1);
      else return;
      event.preventDefault();
    });

    // The counter follows the track once it settles on a photo, however it got there.
    const followTrack = () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      if (index !== current) show(index);
    };
    if ("onscrollend" in window) track.addEventListener("scrollend", followTrack);
    else {
      let settling: ReturnType<typeof setTimeout> | undefined;
      track.addEventListener("scroll", () => {
        clearTimeout(settling);
        settling = setTimeout(followTrack, 100);
      });
    }
    // Keep the current photo in place when the screen turns or resizes.
    new ResizeObserver(() => track.scrollTo({ left: current * track.clientWidth, behavior: "instant" })).observe(track);

    viewer.classList.add("enhanced");
  }

  const showViewer = (viewer: HTMLDialogElement) => {
    viewer.showModal();
    toCover.get(viewer)!();
  };

  // The tapped card's photo grows into the viewer's cover photo, and shrinks back into the card on close:
  // a View Transition in which the photo's content stays lined up, the card's crop easing out to the whole
  // photo while the arch cross-fades into the paper mat. Only transform and opacity move. Under "reduce
  // motion", or without View Transitions, the viewer simply fades or appears.
  const canMove = () => "startViewTransition" in document && !reduceMotion.matches;
  const photoName = "setup-photo";

  /** A photo as the transition sees it: the element that moves, and the photo shown inside it. */
  interface Framed {
    frame: HTMLElement;
    photo: HTMLImageElement;
  }

  /** Where the frame is, and how large the photo is shown in it, in screen pixels per photo pixel. */
  const measure = ({ frame, photo }: Framed) => {
    const shown = photo.getBoundingClientRect();
    const style = getComputedStyle(photo);
    const width = shown.width - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    const height = shown.height - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom);
    // Covering its frame, as the card's photo does, or fitting it whole, as the viewer's does.
    return { box: frame.getBoundingClientRect(), scale: Math.max(width / photo.naturalWidth, height / photo.naturalHeight) };
  };

  const onScreen = ({ frame, photo }: Framed) => frame.getClientRects().length > 0 && photo.naturalWidth > 0;

  let moving: ViewTransition | undefined;
  const unname = () => {
    for (const named of document.querySelectorAll<HTMLElement>(".setup-photo-moving")) {
      named.style.removeProperty("view-transition-name");
      named.classList.remove("setup-photo-moving");
    }
  };
  const name = (element: HTMLElement) => {
    element.style.setProperty("view-transition-name", photoName);
    element.classList.add("setup-photo-moving");
  };

  /**
   * Runs `update` as a View Transition in which `from` moves to where the photo it returns is shown, over
   * the `duration` token. If it returns none, `from` just fades with the rest. The direction is marked on
   * the page while it runs.
   */
  const move = (
    from: Framed,
    update: () => Promise<Framed | undefined>,
    duration: string,
    direction: "opening" | "closing",
  ) => {
    moving?.skipTransition();
    unname();
    const before = measure(from);
    const root = document.documentElement;
    root.classList.add(`viewer-${direction}`);
    name(from.frame);
    let to: Framed | undefined;
    const transition = document.startViewTransition(async () => {
      unname();
      to = await update();
      if (to && moving === transition) name(to.frame);
      else to = undefined;
    });
    moving = transition;

    const pseudo = (part: string) => `::view-transition-${part}(${photoName})`;
    const timing = { duration: milliseconds(duration), easing: token("--ease-carry"), fill: "both" } as const;
    // Held at their end until the transition is over, then let go.
    const animations: Animation[] = [];
    transition.ready
      .then(() => {
        if (!to) {
          animations.push(root.animate({ opacity: [1, 0] }, { ...timing, pseudoElement: pseudo("old") }));
          return;
        }
        // Both photos are drawn from their top left corner, the width of where the photo ends up. Each is
        // placed so the photo's centre and size match the other's at the start or end.
        const after = measure(to);
        const [a, b] = [before.box, after.box];
        const grow = after.scale / before.scale;
        const drawn = b.width / a.width;
        animations.push(root.animate(
          {
            transform: [
              `translate(${a.x - b.x}px, ${a.y - b.y}px) scale(${1 / drawn})`,
              `translate(${(b.width - grow * a.width) / 2}px, ${(b.height - grow * a.height) / 2}px) scale(${grow / drawn})`,
            ],
            opacity: [1, 0],
          },
          { ...timing, pseudoElement: pseudo("old") },
        ));
        animations.push(root.animate(
          {
            transform: [
              `translate(${a.x + a.width / 2 - b.x - b.width / grow / 2}px, ${a.y + a.height / 2 - b.y - b.height / grow / 2}px) scale(${1 / grow})`,
              "none",
            ],
            opacity: [0, 1],
          },
          { ...timing, pseudoElement: pseudo("new") },
        ));
      })
      .catch(() => {});
    transition.finished.finally(() => {
      for (const animation of animations) animation.cancel();
      root.classList.remove(`viewer-${direction}`);
      if (moving !== transition) return;
      unname();
      moving = undefined;
    });
  };

  const coverOf = (viewer: HTMLDialogElement) => viewer.querySelector<HTMLImageElement>(".track img")!;
  /** The viewer's cover photo moves as itself, in its mat. */
  const framed = (cover: HTMLImageElement): Framed => ({ frame: cover, photo: cover });
  /** The card's photo in its arch, beside the button that opens the viewer. */
  const cardOf = (opener: HTMLElement): Framed | undefined => {
    const frame = opener.closest("li")?.querySelector<HTMLElement>(".arch");
    const photo = frame?.querySelector("img");
    return frame && photo ? { frame, photo } : undefined;
  };

  // A cover still loading has nothing to grow into, so it's fetched as soon as the visitor reaches for the card.
  const fetchCover = (viewer: HTMLDialogElement) => {
    coverOf(viewer).loading = "eager";
  };
  // How long the page may hold still for a cover that's still on its way, before opening without it.
  const coverWait = 300;

  const cards = new Map<HTMLDialogElement, Framed>();
  // Viewers shrinking back into their card, which close once the transition has captured them open. They
  // count as closed already, and history can call one back before it goes.
  const closing = new Set<HTMLDialogElement>();
  const isOpen = (viewer: HTMLDialogElement) => viewer.open && !closing.has(viewer);

  /** Closes the viewer, shrinking its cover photo back into the card if that's the photo showing. */
  const closeViewer = (viewer: HTMLDialogElement) => {
    const card = cards.get(viewer);
    const cover = coverOf(viewer);
    if (!isOpen(viewer)) return;
    if (!card || !canMove() || !onCover.get(viewer)!() || !onScreen(framed(cover))) {
      viewer.close();
      return;
    }
    closing.add(viewer);
    move(
      framed(cover),
      async () => {
        if (!closing.delete(viewer)) return undefined;
        viewer.close();
        return onScreen(card) ? card : undefined;
      },
      "--duration-open",
      "closing",
    );
  };

  const growInto = (viewer: HTMLDialogElement, card: Framed) => {
    fetchCover(viewer);
    move(
      card,
      async () => {
        showViewer(viewer);
        const cover = coverOf(viewer);
        if (!cover.complete) {
          await Promise.race([cover.decode().catch(() => {}), new Promise((settled) => setTimeout(settled, coverWait))]);
        }
        if (!onScreen(framed(cover))) return undefined;
        cover.classList.remove("loading");
        return framed(cover);
      },
      "--duration-grow",
      "opening",
    );
  };

  const showViewerFromHistory = () => {
    const id = viewerIn(history.state);
    for (const viewer of viewers) {
      if (viewer.id === id && closing.delete(viewer)) moving?.skipTransition();
      else if (viewer.id === id && !viewer.open) showViewer(viewer);
      if (viewer.id !== id && isOpen(viewer)) closeViewer(viewer);
    }
  };

  /** Opens the viewer from its card, growing it from the card's photo. */
  const open = (viewer: HTMLDialogElement) => {
    history.pushState({ setupViewer: viewer.id } satisfies ViewerEntry, "");
    const card = cards.get(viewer);
    if (card && canMove() && onScreen(card)) growInto(viewer, card);
    else showViewer(viewer);
  };

  // Going back takes a moment on a slow phone. A tap in that moment opens its viewer once the back is
  // done, as otherwise the late back would land on the closed viewer's entry and show that one again.
  let goingBack = false;
  let openWhenBack: HTMLDialogElement | undefined;

  for (const viewer of viewers) {
    const opener = document.querySelector<HTMLButtonElement>(`[commandfor="${viewer.id}"]`)!;
    const card = cardOf(opener);
    if (card) cards.set(viewer, card);
    for (const reaching of ["pointerenter", "focus"]) opener.addEventListener(reaching, () => fetchCover(viewer));
    opener.addEventListener("click", (event) => {
      // Opened here instead of by the button's command, so opening adds the history entry.
      event.preventDefault();
      if (goingBack) openWhenBack = viewer;
      else open(viewer);
    });
    // Close and Escape close the viewer here instead of by themselves, so it can shrink back into the card.
    viewer.querySelector(".close")!.addEventListener("click", (event) => {
      event.preventDefault();
      closeViewer(viewer);
    });
    viewer.addEventListener("cancel", (event) => {
      // Some Escapes can't be held back, and close the viewer at once by themselves.
      if (!event.cancelable) return;
      event.preventDefault();
      closeViewer(viewer);
    });
    viewer.addEventListener("close", () => {
      // Heard late, after forward has already opened it again: that close is undone.
      if (viewer.open) return;
      // Closed with the Close button or Escape, still on its entry: go back off it, so back then leaves the page.
      if (viewerIn(history.state) === viewer.id) {
        goingBack = true;
        history.back();
      }
      opener.focus();
    });
  }

  // Photos still loading wait unseen and fade in once ready (see the styles). Marked by the script, so
  // without it every photo simply shows.
  for (const photo of document.querySelectorAll<HTMLImageElement>(".setup-viewer .track img")) {
    if (photo.complete) continue;
    photo.classList.add("loading");
    const settled = () => photo.classList.remove("loading");
    photo.addEventListener("load", settled, { once: true });
    photo.addEventListener("error", settled, { once: true });
  }

  addEventListener("popstate", () => {
    goingBack = false;
    showViewerFromHistory();
    if (openWhenBack) open(openWhenBack);
    openWhenBack = undefined;
  });
  showViewerFromHistory();
</script>

<style>
  .setup-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--color-wall);
    color: var(--color-bg);
    overscroll-behavior: contain;
    /* Phone: the caption and Close quietly at the top, the photo filling what's left, the counter under it. */
    grid-template: auto minmax(0, 1fr) auto / minmax(0, 1fr) auto;
    grid-template-areas:
      "label close"
      "track track"
      "counter counter";
  }

  .setup-viewer[open] {
    display: grid;
  }

  /* The page behind stays where it was while a viewer is open, without shifting sideways as its scrollbar goes. */
  :global(html:has(.setup-viewer)) {
    scrollbar-gutter: stable;
  }

  :global(html:has(.setup-viewer[open])) {
    overflow: hidden;
  }

  .setup-viewer::backdrop {
    background: var(--color-wall);
  }

  /* The forest focus ring would vanish on the wall. */
  .setup-viewer :focus-visible {
    outline-color: var(--color-bg);
  }

  /* The wall fades in over the page, and fades away a little faster on close. */
  @media (prefers-reduced-motion: no-preference) {
    .setup-viewer,
    .setup-viewer::backdrop {
      transition:
        opacity var(--duration-exit) ease-in,
        display var(--duration-exit) allow-discrete,
        overlay var(--duration-exit) allow-discrete;
    }

    .setup-viewer[open],
    .setup-viewer[open]::backdrop {
      transition-duration: var(--duration-open);
      transition-timing-function: var(--ease-settle);
    }

    .setup-viewer:not([open]),
    .setup-viewer:not([open])::backdrop {
      opacity: 0;
    }

    @starting-style {
      .setup-viewer[open],
      .setup-viewer[open]::backdrop {
        opacity: 0;
      }
    }

    /* A photo still loading is held back, then fades in rather than popping in. */
    .track img {
      transition: opacity 500ms ease-out;
    }

    .track img.loading {
      opacity: 0;
    }
  }

  /*
   * While the card's photo grows into the viewer or shrinks back (see the script), the View Transition
   * fades the wall in or out, so the viewer's own fades hold still and the header stays under the wall.
   */
  :global(html.viewer-opening) .setup-viewer,
  :global(html.viewer-opening) .setup-viewer::backdrop,
  :global(html.viewer-opening) .track img,
  :global(html.viewer-closing) .setup-viewer,
  :global(html.viewer-closing) .setup-viewer::backdrop {
    transition: none;
  }

  :global(html:is(.viewer-opening, .viewer-closing) .site-header) {
    view-transition-name: none;
  }

  /*
   * The page and the wall are both opaque, so fading the new one in over the old is the same cross-fade the
   * browser would draw, with one layer moving and no blending. The browser's own animations here (a size it
   * never changes, and the blend mode) would run on the main thread every frame, and stutter on a slower machine.
   */
  :global(html:is(.viewer-opening, .viewer-closing)::view-transition-group(root)),
  :global(html:is(.viewer-opening, .viewer-closing)::view-transition-old(root)) {
    animation: none;
  }

  :global(html:is(.viewer-opening, .viewer-closing)::view-transition-new(root)) {
    animation: viewer-wall-fade var(--duration-grow) var(--ease-carry) both;
    mix-blend-mode: normal;
  }

  :global(html.viewer-closing::view-transition-new(root)) {
    animation-duration: var(--duration-open);
  }

  @keyframes viewer-wall-fade {
    from {
      opacity: 0;
    }
  }

  /* The photo is moved by the script alone, with transform and opacity: none of the browser's own resizing. */
  :global(::view-transition-group(setup-photo)),
  :global(::view-transition-image-pair(setup-photo)),
  :global(::view-transition-old(setup-photo)),
  :global(::view-transition-new(setup-photo)) {
    animation: none;
  }

  :global(::view-transition-image-pair(setup-photo)) {
    isolation: isolate;
  }

  :global(::view-transition-old(setup-photo)),
  :global(::view-transition-new(setup-photo)) {
    transform-origin: 0 0;
    mix-blend-mode: plus-lighter;
  }

  .label {
    grid-area: label;
    align-self: center;
    padding: var(--space-sm) 0 var(--space-sm) var(--gutter);
  }

  .event-type {
    margin: 0;
    color: var(--color-on-wall-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: inherit;
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .close-form {
    grid-area: close;
    align-self: center;
    padding: var(--space-sm) var(--gutter);
  }

  /* Close, Previous and Next: labelled outline pills, as a gallery attendant would say it, quiet on the wall. */
  .wall-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    height: 2.75rem;
    padding: 0 var(--space-md);
    border: 1px solid var(--color-on-wall-line);
    border-radius: 100vmax;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .wall-button:not(:disabled):hover {
    background: var(--color-on-wall-hover);
  }

  .wall-button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .close {
    padding-left: var(--space-sm);
  }

  .setup-viewer svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .track {
    grid-area: track;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  /* Drawn inside the track, where it can't run off the screen's edge or over the caption beside it. */
  .track:focus-visible {
    outline-offset: -2px;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Each photo has a whole screen of the track to itself, so its space is there before it loads. */
  .track li {
    flex: 0 0 100%;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    padding: var(--space-md) var(--gutter);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  /* Hung like a print: the whole photo, uncropped, in a thin paper mat. */
  .track img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    padding: 0.375rem;
    background: var(--color-bg);
    border-radius: var(--radius);
  }

  /* No mat until the photo arrives, or a bare paper square would sit in the middle of its space. */
  .track img.loading {
    background: transparent;
  }

  .counter {
    grid-area: counter;
    justify-self: center;
    margin: 0;
    padding: 0 var(--gutter) var(--space-md);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .of {
    color: var(--color-on-wall-muted);
    font-size: 0.6em;
  }

  /* Phone: only the counter. The photo has the whole screen, and swiping moves it. */
  .steps,
  .thumbnails {
    display: none;
  }

  .steps {
    grid-area: steps;
    gap: var(--space-sm);
  }

  .steps button {
    flex: 1;
  }

  /*
   * Desktop: the photo on the wall to the left, and a label column to the right holding Close, the caption,
   * the counter, Previous and Next, and the thumbnails.
   */
  @media (min-width: 48rem) and (pointer: fine) {
    .setup-viewer {
