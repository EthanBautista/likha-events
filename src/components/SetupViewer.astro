---
import type { Setup } from "../setups";
import Photo from "./Photo.astro";

interface Props {
  setup: Setup;
  /** The viewer's element id, which the button that opens it points at. */
  id: string;
}

const { setup, id } = Astro.props;
const { caption, coverPhoto, photos } = setup.data;
const allPhotos = [coverPhoto, ...photos];
---

<!-- A modal dialog keeps focus inside while open, closes on Escape, and hands focus back on close. -->
<dialog class="setup-viewer" id={id} aria-labelledby={`${id}-caption`}>
  <div class="bar">
    <h2 id={`${id}-caption`}>{caption}</h2>
    <form method="dialog">
      <button type="submit" autofocus>Close</button>
    </form>
  </div>
  <ul class="photos" aria-label="Photos">
    {
      allPhotos.map((photo, index) => (
        <li>
          <Photo
            src={photo}
            alt={`${caption}, photo ${index + 1} of ${allPhotos.length}`}
            sizes="(min-width: 60rem) 56rem, 100vw"
          />
        </li>
      ))
    }
  </ul>
</dialog>

<style>
  .setup-viewer {
    width: 100%;
    max-width: 60rem;
    max-height: 100%;
    height: 100%;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* The gallery behind stays where it was while the viewer is open. */
  :global(html:has(.setup-viewer[open])) {
    overflow: hidden;
  }

  .setup-viewer::backdrop {
    background: rgb(48 56 56 / 0.85);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--gutter);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  form {
    flex-shrink: 0;
  }

  button {
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-action);
    border-radius: 100vmax;
    background: var(--color-action);
    color: var(--color-on-action);
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-action-hover);
  }

  .photos {
    list-style: none;
    margin: 0;
    padding: var(--space-md) var(--gutter) var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  .photos img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
