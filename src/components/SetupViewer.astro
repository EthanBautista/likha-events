---
import type { Setup } from "../setups";
import Photo from "./Photo.astro";

interface Props {
  setup: Setup;
  /**
   * The viewer's element id. The page gives each viewer a hidden button with `aria-controls` set to
   * this id, which the script shows and makes open the viewer.
   */
  id: string;
}

const { setup, id } = Astro.props;
const { caption, coverPhoto, photos } = setup.data;
const allPhotos = [coverPhoto, ...photos];
---

<!-- A modal dialog keeps focus inside while open, closes on Escape, and hands focus back on close. -->
<dialog class="setup-viewer" id={id} aria-labelledby={`${id}-caption`}>
  <div class="bar">
    <h2 id={`${id}-caption`}>{caption}</h2>
    <form method="dialog">
      <button type="submit" autofocus>Close</button>
    </form>
  </div>
  <ul class="photos" aria-label="Photos">
    {
      allPhotos.map((photo, index) => (
        <li>
          <Photo
            src={photo}
            alt={`${caption}, photo ${index + 1} of ${allPhotos.length}`}
            sizes="(min-width: 60rem) 56rem, 100vw"
          />
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  // An open viewer has its own history entry at the same URL, recording which viewer is open. So the
  // browser or phone back gesture closes it instead of leaving the page, and forward or a reload opens it again.
  interface ViewerEntry {
    setupViewer: string;
  }
  const viewerIn = (state: unknown) => (state as Partial<ViewerEntry> | null)?.setupViewer;

  const viewers = [...document.querySelectorAll<HTMLDialogElement>(".setup-viewer")];

  const showViewerFromHistory = () => {
    const id = viewerIn(history.state);
    for (const viewer of viewers) {
      if (viewer.id === id && !viewer.open) viewer.showModal();
      if (viewer.id !== id && viewer.open) viewer.close();
    }
  };

  for (const viewer of viewers) {
    const opener = document.querySelector<HTMLButtonElement>(`[aria-controls="${viewer.id}"]`)!;
    opener.hidden = false;
    opener.addEventListener("click", () => {
      history.pushState({ setupViewer: viewer.id } satisfies ViewerEntry, "");
      viewer.showModal();
    });
    viewer.addEventListener("close", () => {
      // Closed with the Close button or Escape, still on its entry: go back off it, so back then leaves the page.
      if (viewerIn(history.state) === viewer.id) history.back();
      opener.focus();
    });
  }

  addEventListener("popstate", showViewerFromHistory);
  showViewerFromHistory();
</script>

<style>
  .setup-viewer {
    width: 100%;
    max-width: 60rem;
    max-height: 100%;
    height: 100%;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* The page behind stays where it was while a viewer is open, without shifting sideways as its scrollbar goes. */
  :global(html:has(.setup-viewer)) {
    scrollbar-gutter: stable;
  }

  :global(html:has(.setup-viewer[open])) {
    overflow: hidden;
  }

  .setup-viewer::backdrop {
    background: rgb(48 56 56 / 0.85);
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--gutter);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  form {
    flex-shrink: 0;
  }

  button {
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-action);
    border-radius: 100vmax;
    background: var(--color-action);
    color: var(--color-on-action);
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    background: var(--color-action-hover);
  }

  .photos {
    list-style: none;
    margin: 0;
    padding: var(--space-md) var(--gutter) var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  .photos img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
</style>
