---
import type { Setup } from "../setups";
import Photo from "./Photo.astro";

interface Props {
  setup: Setup;
  /**
   * The viewer's element id. The page opens each viewer with a button that has `commandfor` set to this
   * id and `command="show-modal"`, which works without JavaScript.
   */
  id: string;
}

const { setup, id } = Astro.props;
const { caption, coverPhoto, photos } = setup.data;
const allPhotos = [coverPhoto, ...photos];
---

<!-- A modal dialog keeps focus inside while open, closes on Escape, and hands focus back on close. -->
<dialog class="setup-viewer" id={id} aria-labelledby={`${id}-caption`}>
  <div class="bar">
    <h2 id={`${id}-caption`}>{caption}</h2>
    <form method="dialog">
      <button type="submit" class="pill pill-solid" autofocus>Close</button>
    </form>
  </div>
  <ul class="photos" aria-label="Photos">
    {
      allPhotos.map((photo, index) => (
        <li>
          <Photo
            src={photo}
            alt={`${caption}, photo ${index + 1} of ${allPhotos.length}`}
            sizes="(min-width: 60rem) 56rem, 100vw"
          />
        </li>
      ))
    }
  </ul>
</dialog>

<script>
  // An open viewer has its own history entry at the same URL, recording which viewer is open. So the
  // browser or phone back gesture closes it instead of leaving the page, and forward or a reload opens it again.
  interface ViewerEntry {
    setupViewer: string;
  }
  const viewerIn = (state: unknown) => (state as Partial<ViewerEntry> | null)?.setupViewer;

  const viewers = [...document.querySelectorAll<HTMLDialogElement>(".setup-viewer")];

  const showViewerFromHistory = () => {
    const id = viewerIn(history.state);
    for (const viewer of viewers) {
      if (viewer.id === id && !viewer.open) viewer.showModal();
      if (viewer.id !== id && viewer.open) viewer.close();
    }
  };

  const open = (viewer: HTMLDialogElement) => {
    history.pushState({ setupViewer: viewer.id } satisfies ViewerEntry, "");
    viewer.showModal();
  };

  // Going back takes a moment on a slow phone. A tap in that moment opens its viewer once the back is
  // done, as otherwise the late back would land on the closed viewer's entry and show that one again.
  let goingBack = false;
  let openWhenBack: HTMLDialogElement | undefined;

  for (const viewer of viewers) {
    const opener = document.querySelector<HTMLButtonElement>(`[commandfor="${viewer.id}"]`)!;
    opener.addEventListener("click", (event) => {
      // Opened here instead of by the button's command, so opening adds the history entry.
      event.preventDefault();
      if (goingBack) openWhenBack = viewer;
      else open(viewer);
    });
    viewer.addEventListener("close", () => {
      // Closed with the Close button or Escape, still on its entry: go back off it, so back then leaves the page.
      if (viewerIn(history.state) === viewer.id) {
        goingBack = true;
        history.back();
      }
      opener.focus();
    });
  }

  // Photos still loading wait unseen and fade in once ready (see the styles). Marked by the script, so
  // without it every photo simply shows.
  for (const photo of document.querySelectorAll<HTMLImageElement>(".setup-viewer .photos img")) {
    if (photo.complete) continue;
    photo.classList.add("loading");
    const settled = () => photo.classList.remove("loading");
    photo.addEventListener("load", settled, { once: true });
    photo.addEventListener("error", settled, { once: true });
  }

  addEventListener("popstate", () => {
    goingBack = false;
    showViewerFromHistory();
    if (openWhenBack) open(openWhenBack);
    openWhenBack = undefined;
  });
  showViewerFromHistory();
</script>

<style>
  .setup-viewer {
    width: 100%;
    max-width: 60rem;
    max-height: 100%;
    height: 100%;
    margin: 0 auto;
    padding: 0;
    border: none;
    background: var(--color-bg);
    color: var(--color-text);
    /* Scrolling to the end of the photos doesn't carry on into the page behind. */
    overscroll-behavior: contain;
  }

  /* The page behind stays where it was while a viewer is open, without shifting sideways as its scrollbar goes. */
  :global(html:has(.setup-viewer)) {
    scrollbar-gutter: stable;
  }

  :global(html:has(.setup-viewer[open])) {
    overflow: hidden;
  }

  .setup-viewer::backdrop {
    background: rgb(48 56 56 / 0.85);
  }

  /* The viewer rises gently into place over a darkening page, and drops away a little faster on close. */
  @media (prefers-reduced-motion: no-preference) {
    .setup-viewer,
    .setup-viewer::backdrop {
      transition:
        opacity 200ms ease-in,
        translate 200ms ease-in,
        display 200ms allow-discrete,
        overlay 200ms allow-discrete;
    }

    .setup-viewer[open],
    .setup-viewer[open]::backdrop {
      transition-duration: 380ms;
      transition-timing-function: var(--ease-settle);
    }

    .setup-viewer:not([open]) {
      opacity: 0;
      translate: 0 1rem;
    }

    .setup-viewer:not([open])::backdrop {
      opacity: 0;
    }

    @starting-style {
      .setup-viewer[open] {
        opacity: 0;
        translate: 0 1.5rem;
      }

      .setup-viewer[open]::backdrop {
        opacity: 0;
      }
    }

    /* A photo still loading is held back, then fades in rather than popping in. */
    .photos img {
      transition: opacity 500ms ease-out;
    }

    .photos img.loading {
      opacity: 0;
    }
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--gutter);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  form {
    flex-shrink: 0;
  }

  .photos {
    list-style: none;
    margin: 0;
    padding: var(--space-md) var(--gutter) var(--space-xl);
    display: grid;
    gap: var(--space-md);
  }

  /* Each photo fits on screen below the bar, so moving down the list shows one whole photo at a time. */
  .photos img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    /* The bar is about 4.5rem tall; the rest leaves a little paper above and below. */
    max-height: calc(100dvh - 6rem);
    margin-inline: auto;
    border-radius: var(--radius);
  }
</style>
