---
import Wordmark from "../assets/brand/logo-wordmark.svg";
import { siteName, social } from "../site-settings";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <Wordmark class="wordmark" aria-hidden="true" focusable="false" />
      <p class="tagline">We create. You celebrate.</p>
    </div>
    <ul class="social" aria-label="Follow Likha Events">
      <li>
        <a href={social.instagram}>
          <SocialIcon network="instagram" />
          Instagram
        </a>
      </li>
      <li>
        <a href={social.facebook}>
          <SocialIcon network="facebook" />
          Facebook
        </a>
      </li>
    </ul>
    <p class="copyright">© {year} {siteName}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--color-sage-band);
  }

  .inner {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--space-lg);
  }

  .wordmark {
    width: 5.5rem;
    height: auto;
    color: var(--color-action);
  }

  .tagline {
    margin: var(--space-xs) 0 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    text-decoration: none;
  }

  .social a:hover {
    text-decoration: underline;
  }

  .copyright {
    max-width: none;
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .copyright {
      grid-column: 1 / -1;
    }
  }
</style>
