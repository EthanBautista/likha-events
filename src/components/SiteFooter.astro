---
import Wordmark from "../assets/brand/logo-wordmark.svg";
import { siteName, social } from "../site-settings";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand">
      <Wordmark class="wordmark" aria-hidden="true" focusable="false" />
      <p class="tagline">We create. You celebrate.</p>
    </div>
    <ul class="social" aria-label="Follow Likha Events">
      <li>
        <a href={social.instagram}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
          </svg>
          Instagram
        </a>
      </li>
      <li>
        <a href={social.facebook}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H7v3.5h2V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z" />
          </svg>
          Facebook
        </a>
      </li>
    </ul>
    <p class="copyright">© {year} {siteName}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-2xl);
    background: var(--color-sage-band);
  }

  .inner {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl) var(--space-lg);
  }

  .wordmark {
    width: 5.5rem;
    height: auto;
    color: var(--color-action);
  }

  .tagline {
    margin: var(--space-xs) 0 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    text-decoration: none;
  }

  .social a:hover {
    text-decoration: underline;
  }

  .social svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .copyright {
    max-width: none;
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .copyright {
      grid-column: 1 / -1;
    }
  }
</style>
