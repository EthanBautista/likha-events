---
// An outline icon for one of the social networks in site settings. Decorative: the link it sits in
// carries the name.
interface Props {
  network: "instagram" | "facebook";
}

const { network } = Astro.props;
---

<svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    network === "instagram" ? (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
      </>
    ) : (
      <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V10H7v3.5h2V21h3.5v-7.5H15l.5-3.5h-3V7a1 1 0 0 1 1-1H15z" />
    )
  }
</svg>

<style>
  .social-icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
