---
import Wordmark from "../assets/brand/logo-wordmark.svg";
import { mainMenu, siteName } from "../site-settings";

const normalise = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const currentPath = normalise(Astro.url.pathname);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/" aria-label={`${siteName}, home`}>
      <Wordmark aria-hidden="true" focusable="false" />
    </a>
    <!-- Hidden until the script runs, so without JavaScript the menu simply stays open. -->
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-menu" hidden>
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>
    <nav aria-label="Main">
      <ul class="menu" id="main-menu">
        {
          mainMenu.map(({ label, href }) => (
            <li>
              <a class="link-line" href={href} aria-current={currentPath === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const button = header.querySelector<HTMLButtonElement>(".menu-button")!;

  const setOpen = (open: boolean) => {
    header.dataset.menu = open ? "open" : "closed";
    button.setAttribute("aria-expanded", String(open));
  };

  setOpen(false);
  button.hidden = false;
  // The menu's opening and closing motion starts only once its closed state is in place, so it doesn't play
  // as the menu tucks away on load. Reading a computed style makes the browser apply that state first.
  getComputedStyle(header.querySelector("nav")!).display;
  header.dataset.menuReady = "";

  button.addEventListener("click", () => setOpen(header.dataset.menu !== "open"));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header.dataset.menu === "open") {
      setOpen(false);
      button.focus();
    }
  });
  // The open menu lies over the page, so a tap anywhere else, or tabbing on past it, puts it away.
  document.addEventListener("click", (event) => {
    if (header.dataset.menu === "open" && !header.contains(event.target as Node)) setOpen(false);
  });
  header.addEventListener("focusout", (event) => {
    const next = event.relatedTarget as Node | null;
    if (header.dataset.menu === "open" && next && !header.contains(next)) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--space-md);
    min-height: 5rem;
  }

  .logo {
    display: block;
    padding-block: var(--space-sm);
    color: var(--color-action);
    line-height: 0;
  }

  .logo:hover {
    color: var(--color-action-hover);
  }

  .logo :global(svg) {
    width: 6.5rem;
    height: auto;
  }

  .menu {
    display: flex;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  /* The hover line is sage; the current page's is forest. */
  .menu a::after {
    background: var(--color-sage);
  }

  .menu a:hover,
  .menu a[aria-current="page"] {
    color: var(--color-action);
  }

  .menu a:active {
    color: var(--color-action-hover);
  }

  .menu a[aria-current="page"]::after {
    background: currentColor;
  }

  .menu-button {
    display: none;
  }

  /* Below tablet width the menu collapses behind the menu button. */
  @media (max-width: 47.99rem) {
    .menu-button:not([hidden]) {
      display: inline-flex;
      align-items: center;
      gap: var(--space-xs);
      min-height: 2.75rem;
      padding: var(--space-xs) var(--space-sm);
      border: 1px solid var(--color-line);
      border-radius: var(--radius);
      background: transparent;
      color: var(--color-text);
      font: inherit;
      font-size: var(--text-sm);
      letter-spacing: 0.04em;
      cursor: pointer;
    }

    .menu-button:active {
      background: var(--color-sage-band);
    }

    @media (hover: hover) {
      .menu-button:hover {
        background: var(--color-sage-band);
      }
    }

    /* The three lines fold into an × as the menu opens. */
    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 1.125rem;
      height: 1px;
      background: currentColor;
    }

    .menu-icon {
      position: relative;
    }

    .menu-icon::before,
    .menu-icon::after {
      content: "";
      position: absolute;
      left: 0;
    }

    .menu-icon::before {
      translate: 0 -0.3125rem;
    }

    .menu-icon::after {
      translate: 0 0.3125rem;
    }

    [data-menu="open"] .menu-icon {
      background: transparent;
    }

    [data-menu="open"] .menu-icon::before {
      translate: 0;
      rotate: 45deg;
    }

    [data-menu="open"] .menu-icon::after {
      translate: 0;
      rotate: -45deg;
    }

    /* Without the script the menu stays open, on a line of its own under the logo. */
    nav {
      flex-basis: 100%;
    }

    /* With it, the menu opens as a panel lying over the page just under the header, so nothing below shifts. */
    [data-menu] nav {
      position: absolute;
      z-index: 5;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-line);
    }

    .menu {
      flex-direction: column;
      gap: 0;
      padding: var(--space-xs) var(--gutter) var(--space-md);
    }

    .menu a {
      display: flex;
      width: fit-content;
      min-height: 3rem;
      font-size: var(--text-base);
    }

    .menu a::after {
      bottom: 0.5rem;
    }

    [data-menu="closed"] nav {
      display: none;
    }
  }

  /* The panel slides down a little as it fades in, and lifts away a little faster as it closes. */
  @media (max-width: 47.99rem) and (prefers-reduced-motion: no-preference) {
    [data-menu-ready] nav {
      transition:
        opacity var(--duration-open) var(--ease-settle),
        translate var(--duration-open) var(--ease-settle),
        display var(--duration-open) allow-discrete;
    }

    [data-menu-ready][data-menu="closed"] nav {
      opacity: 0;
      translate: 0 -0.75rem;
      transition-duration: var(--duration-exit);
      transition-timing-function: ease-in;
    }

    @starting-style {
      [data-menu="open"] nav {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }

    .menu-button {
      transition: background-color var(--duration-exit) ease-out;
    }

    .menu-icon::before,
    .menu-icon::after {
      transition:
        translate var(--duration-open) var(--ease-settle),
        rotate var(--duration-open) var(--ease-settle);
    }
  }
</style>
