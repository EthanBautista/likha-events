---
import { formatPrice } from "../packages";
import type { Rental } from "../rentals";
import Photo from "./Photo.astro";

interface Props {
  rental: Rental;
  /** How wide the card is shown, passed on to the photo. */
  sizes: string;
}

const { rental, sizes } = Astro.props;
const { name, photo, price, description, sample } = rental.data;
---

<article class="rental-card">
  <div class="arch">
    <Photo src={photo} alt={name} sizes={sizes} />
    {sample && <span class="sample">Sample</span>}
  </div>
  <h3>{name}</h3>
  <p class="price">{formatPrice(price)} per event</p>
  <p class="description">{description}</p>
</article>

<style>
  .rental-card {
    text-align: center;
  }

  /* The brand's arch: a portrait frame with a semicircular top. Photos are cropped by CSS only. */
  .arch {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
    background: var(--color-sage-band);
  }

  .arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sample {
    position: absolute;
    left: 50%;
    bottom: var(--space-sm);
    translate: -50% 0;
    padding: 0.125rem var(--space-xs);
    border-radius: var(--radius);
    background: var(--color-action);
    color: var(--color-on-action);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-lg);
  }

  .price {
    margin: var(--space-xs) 0;
    color: var(--color-action);
  }

  .description {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
