---
import "@fontsource-variable/cormorant-garamond";
import "@fontsource-variable/jost";
import "../../styles/tokens.css";
import "../../styles/global.css";
import { getEventTypes } from "../../event-types-list";
import { maxPhotos } from "../../inquiry-form";
import { handAddedSources } from "../../inquiry-sources";
import { inquiryStatuses } from "../../inquiry-statuses";
import { siteName } from "../../site-settings";

const eventTypes = await getEventTypes();

// The Inquiry dashboard (ADR 0004): a static page whose script signs the owner in with GitHub through
// Netlify's OAuth provider, the same login as the editor, and asks the Inquiry functions for Inquiries.
// The functions decide who may see them; this page only keeps the sign-in and shows what they send.
// The list, an opened Inquiry and the form for adding one or editing its details are all this page:
// an opened one is `?inquiry=<id>`, adding one is `?add` and editing one is `?edit=<id>`, so the
// phone's back button and a reload both work.
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Inquiries · {siteName}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="dashboard-bar">
      <div class="container dashboard-bar-inner">
        <span class="dashboard-name">{siteName}</span>
        <nav aria-label="Owner pages" class="dashboard-nav">
          <a class="link-line" href="/admin/">Editor</a>
          <button type="button" class="pill" data-sign-out hidden>Sign out</button>
        </nav>
      </div>
    </header>

    <main id="main" class="container dashboard">
      <a class="dashboard-back link-line" href="/admin/inquiries/" data-back hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" /></svg>
        All Inquiries
      </a>
      <h1 id="dashboard-heading" data-heading>Inquiries</h1>
      <p role="alert" class="dashboard-problem" data-problem></p>

      <section data-view="signed-out" class="dashboard-sign-in">
        <p>Sign in with the GitHub account you use for the editor.</p>
        <button type="button" class="pill pill-solid" data-sign-in>Sign in with GitHub</button>
      </section>

      <p data-view="loading" class="dashboard-quiet" hidden>Loading Inquiries…</p>

      <section data-view="list" hidden>
        <a class="pill pill-solid inquiry-add" href="?add" data-add>Add Inquiry</a>
        <p role="status" class="inquiry-saved" data-list-saved></p>
        <div data-empty class="dashboard-empty" hidden>
          <p class="dashboard-empty-title">No Inquiries yet</p>
          <p class="dashboard-quiet">
            Each Inquiry sent through the contact form will appear here. Add ones from Instagram or Facebook
            with Add Inquiry.
          </p>
        </div>
        <div data-overview class="inquiry-overview">
          <p class="inquiry-new-count" data-new-count></p>
          <div class="inquiry-filter" role="group" aria-label="Filter by Inquiry status">
            <button type="button" class="pill" aria-pressed="true">All</button>
            {
              inquiryStatuses.map((status) => (
                <button type="button" class="pill" aria-pressed="false" data-status={status}>
                  {status}
                </button>
              ))
            }
          </div>
          <p class="visually-hidden" role="status" data-filter-status></p>
          <p class="dashboard-quiet" data-none-shown hidden></p>
        </div>
        <div data-groups></div>
      </section>

      <article data-view="detail" class="inquiry" hidden>
        <p class="inquiry-received" data-received></p>
        <p role="status" class="inquiry-saved" data-details-saved></p>
        <fieldset class="inquiry-choice" data-status-choice>
          <legend>Inquiry status</legend>
          <div class="inquiry-choice-options">
            {
              inquiryStatuses.map((status) => (
                <label class="pill">
                  <input type="radio" name="status" value={status} />
                  {status}
                </label>
              ))
            }
          </div>
        </fieldset>
        <p role="status" class="inquiry-saved" data-status-saved></p>
        <div class="inquiry-notes">
          <label for="inquiry-notes">Notes</label>
          <textarea id="inquiry-notes" rows="4" data-notes></textarea>
          <div class="inquiry-notes-save">
            <button type="button" class="pill" data-save-notes>Save notes</button>
            <p role="status" class="inquiry-saved" data-notes-saved></p>
          </div>
        </div>
        <h2 data-answers-heading>What they sent</h2>
        <dl class="inquiry-answers" data-answers></dl>
        <a class="pill inquiry-edit" data-edit hidden>Edit details</a>
        <h2>Inspiration photos</h2>
        <div class="inquiry-photos" data-photos></div>
        <!--
          Deleting is for spam that slipped through or a duplicate, so it asks first, naming the Inquiry, and
          points a customer who just didn't book to Declined, which keeps a record of them.
        -->
        <div class="inquiry-delete">
          <button type="button" class="pill" data-delete>Delete Inquiry</button>
          <section
            class="inquiry-delete-confirm"
            aria-labelledby="inquiry-delete-heading"
            tabindex="-1"
            data-delete-confirm
            hidden
          >
            <h2 id="inquiry-delete-heading" data-delete-heading></h2>
            <p>It's gone for good, with its photos. Delete only spam or a duplicate.</p>
            <p>If they just didn't book, set it to Declined instead, so you keep a record of them.</p>
            <div class="inquiry-delete-actions">
              <button type="button" class="pill pill-solid" data-delete-confirmed>Delete for good</button>
              <button type="button" class="pill" data-decline-instead>Set to Declined instead</button>
              <button type="button" class="link-line" data-delete-cancel>Keep it</button>
            </div>
          </section>
        </div>
      </article>

      <!--
        Adding an Inquiry from an Instagram or Facebook message, or editing the details of one added that
        way. Only a name and a way to reach the customer are needed. Each field's message shows in the
        "-error" line under it, as on the contact form; data-missing is the message when it's left empty,
        and data-invalid when it's filled in wrongly.
      -->
      <form data-view="form" class="inquiry-form" aria-labelledby="dashboard-heading" novalidate hidden>
        <fieldset class="inquiry-choice">
          <legend>Where it came from</legend>
          <div class="inquiry-choice-options">
            {
              handAddedSources.map((source, index) => (
                <label class="pill">
                  <input type="radio" name="source" value={source} checked={index === 0} />
                  {source}
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="field">
          <label for="inquiry-form-name">Name</label>
          <input
            id="inquiry-form-name"
            name="name"
            autocomplete="off"
            data-missing="Enter the customer's name."
            aria-describedby="inquiry-form-name-error"
          />
          <p class="error" id="inquiry-form-name-error"></p>
        </div>

        <div class="field">
          <label for="inquiry-form-contact">Phone, email or handle</label>
          <input
            id="inquiry-form-contact"
            name="contact"
            autocomplete="off"
            data-missing="Enter a way to reach them, such as their Instagram or Facebook name."
            aria-describedby="inquiry-form-contact-error"
          />
          <p class="error" id="inquiry-form-contact-error"></p>
        </div>

        <div class="field">
          <label for="inquiry-form-event-date">Event date <span class="optional">(optional)</span></label>
          <input id="inquiry-form-event-date" name="eventDate" type="date" />
        </div>

        <div class="field">
          <label for="inquiry-form-venue">Venue or city <span class="optional">(optional)</span></label>
          <input id="inquiry-form-venue" name="venue" />
        </div>

        <div class="field">
          <label for="inquiry-form-event-type">Event type <span class="optional">(optional)</span></label>
          <select id="inquiry-form-event-type" name="eventType" data-event-types>
            <option value="">Not known yet</option>
            {eventTypes.all.map((eventType) => <option>{eventType}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="inquiry-form-guests">Number of guests <span class="optional">(optional)</span></label>
          <input
            id="inquiry-form-guests"
            name="guests"
            type="number"
            min="1"
            inputmode="numeric"
            data-invalid="Enter the number of guests as a whole number, like 40."
            aria-describedby="inquiry-form-guests-error"
          />
          <p class="error" id="inquiry-form-guests-error"></p>
        </div>

        <div class="field">
          <label for="inquiry-form-theme">Theme or colours <span class="optional">(optional)</span></label>
          <input id="inquiry-form-theme" name="theme" />
        </div>

        <div class="field">
          <label for="inquiry-form-decor">Décor wanted <span class="optional">(optional)</span></label>
          <textarea id="inquiry-form-decor" name="decor" rows="4"></textarea>
        </div>

        <div class="field" data-photo-field>
          <label for="inquiry-form-photos">Inspiration photos <span class="optional">(optional)</span></label>
          <p class="hint" id="inquiry-form-photos-hint" data-photo-hint></p>
          <input
            id="inquiry-form-photos"
            type="file"
            accept="image/*"
            multiple
            data-max={maxPhotos}
            aria-describedby="inquiry-form-photos-hint inquiry-form-photos-error"
          />
          <p class="error" id="inquiry-form-photos-error"></p>
        </div>

        <div class="inquiry-form-actions">
          <button class="pill pill-solid" type="submit" data-form-submit>Add Inquiry</button>
          <a class="link-line" data-form-cancel>Cancel</a>
        </div>
      </form>
    </main>

    <script>
      import type { Inquiry, InquiryChanges, InquiryPhoto, NewInquiry } from "../../../netlify/inquiries";
      import { eventTiming, inListOrder, torontoToday, type EventTiming } from "../../inquiry-dates";
      import { customerAnswers } from "../../inquiry-form";
      import { inquiryStatuses } from "../../inquiry-statuses";

      /** Netlify's OAuth provider, which the editor signs in through too. */
      const netlify = "https://api.netlify.com";
      const tokenKey = "likha-inquiry-dashboard.github-token";
      const pageTitle = document.title;

      const views = document.querySelectorAll<HTMLElement>("[data-view]");
      const heading = document.querySelector<HTMLElement>("[data-heading]")!;
      const back = document.querySelector<HTMLAnchorElement>("[data-back]")!;
      const problem = document.querySelector<HTMLElement>("[data-problem]")!;
      const signInButton = document.querySelector<HTMLButtonElement>("[data-sign-in]")!;
      const signOutButton = document.querySelector<HTMLButtonElement>("[data-sign-out]")!;
      const empty = document.querySelector<HTMLElement>("[data-empty]")!;
      const groups = document.querySelector<HTMLElement>("[data-groups]")!;
      const received = document.querySelector<HTMLElement>("[data-received]")!;
      const answers = document.querySelector<HTMLElement>("[data-answers]")!;
      const photos = document.querySelector<HTMLElement>("[data-photos]")!;
      const overview = document.querySelector<HTMLElement>("[data-overview]")!;
      const newCount = document.querySelector<HTMLElement>("[data-new-count]")!;
      const filterRow = document.querySelector<HTMLElement>(".inquiry-filter")!;
      const filterButtons = [...filterRow.querySelectorAll("button")];
      const filterStatus = document.querySelector<HTMLElement>("[data-filter-status]")!;
      const noneShown = document.querySelector<HTMLElement>("[data-none-shown]")!;
      const statusChoice = document.querySelector<HTMLFieldSetElement>("[data-status-choice]")!;
      const statusSaved = document.querySelector<HTMLElement>("[data-status-saved]")!;
      const notes = document.querySelector<HTMLTextAreaElement>("[data-notes]")!;
      const saveNotesButton = document.querySelector<HTMLButtonElement>("[data-save-notes]")!;
      const notesSaved = document.querySelector<HTMLElement>("[data-notes-saved]")!;
      const addLink = document.querySelector<HTMLAnchorElement>("[data-add]")!;
      const detailsSaved = document.querySelector<HTMLElement>("[data-details-saved]")!;
      const answersHeading = document.querySelector<HTMLElement>("[data-answers-heading]")!;
      const editLink = document.querySelector<HTMLAnchorElement>("[data-edit]")!;
      const deleteButton = document.querySelector<HTMLButtonElement>("[data-delete]")!;
      const deleteConfirm = document.querySelector<HTMLElement>("[data-delete-confirm]")!;
      const deleteHeading = document.querySelector<HTMLElement>("[data-delete-heading]")!;
      const deleteConfirmed = document.querySelector<HTMLButtonElement>("[data-delete-confirmed]")!;
      const declineInstead = document.querySelector<HTMLButtonElement>("[data-decline-instead]")!;
      const deleteCancel = document.querySelector<HTMLButtonElement>("[data-delete-cancel]")!;
      const listSaved = document.querySelector<HTMLElement>("[data-list-saved]")!;
      const form = document.querySelector<HTMLFormElement>(".inquiry-form")!;
      const eventTypeChoice = form.querySelector<HTMLSelectElement>("[data-event-types]")!;
      const photoField = form.querySelector<HTMLElement>("[data-photo-field]")!;
      const photoHint = form.querySelector<HTMLElement>("[data-photo-hint]")!;
      const photoInput = form.querySelector<HTMLInputElement>("input[type=file]")!;
      const submitButton = form.querySelector<HTMLButtonElement>("[data-form-submit]")!;
      const cancelLink = form.querySelector<HTMLAnchorElement>("[data-form-cancel]")!;

      // The sign-in is kept in this browser so the owner stays signed in on their phone. Storage can be
      // blocked, as in a private window, and then the owner signs in each visit.
      const savedToken = {
        read: () => {
          try {
            return localStorage.getItem(tokenKey) ?? undefined;
          } catch {
            return undefined;
          }
        },
        save: (token: string) => {
          try {
            localStorage.setItem(tokenKey, token);
          } catch {}
        },
        forget: () => {
          try {
            localStorage.removeItem(tokenKey);
          } catch {}
        },
      };

      /** The signed-in owner's GitHub token, and the Inquiries the list function last sent. */
      let token: string | undefined;
      let inquiries: Inquiry[] | undefined;

      function show(view: "signed-out" | "loading" | "list" | "detail" | "form" | "nothing") {
        for (const element of views) element.hidden = element.dataset.view !== view;
        signOutButton.hidden = view === "signed-out";
      }

      function showProblem(message = "") {
        problem.textContent = message;
      }

      /** The GitHub token in the details Netlify's sign-in window hands back, if they hold one. */
      function tokenFrom(details: string): string | undefined {
        try {
          const { token } = JSON.parse(details);
          return typeof token === "string" && token ? token : undefined;
        } catch {
          return undefined;
        }
      }

      /**
       * Opens Netlify's GitHub sign-in window and waits for the GitHub token it hands back, after the
       * handshake Netlify's window expects. Undefined if the window is closed first.
       */
      function signInWithGitHub(): Promise<string | undefined> {
        // Netlify finds the site's GitHub settings by its domain, which a local copy of the site doesn't have.
        const local = ["localhost", "127.0.0.1"].includes(location.hostname);
        const siteId = local ? new URL(import.meta.env.SITE).host : location.host;
        const url = `${netlify}/auth?provider=github&site_id=${encodeURIComponent(siteId)}&scope=repo`;
        const popup = open(url, "github-sign-in", "width=960,height=640");
        if (!popup) return Promise.reject(new Error("Allow pop-ups for this site, then sign in again."));

        return new Promise((resolve, reject) => {
          const finish = () => {
            removeEventListener("message", onMessage);
            clearInterval(closedCheck);
            popup.close();
          };
          const onMessage = (event: MessageEvent) => {
            if (event.origin !== netlify || event.source !== popup || typeof event.data !== "string") return;
            if (event.data === "authorizing:github") {
              popup.postMessage(event.data, event.origin);
              return;
            }
            const success = event.data.match(/^authorization:github:success:(.+)$/s);
            if (!success && !event.data.startsWith("authorization:github:error:")) return;
            finish();
            const token = success && tokenFrom(success[1]);
            if (token) resolve(token);
            else reject(new Error("GitHub didn't sign you in. Try again."));
          };
          const closedCheck = setInterval(() => {
            if (!popup.closed) return;
            finish();
            resolve(undefined);
          }, 500);
          addEventListener("message", onMessage);
        });
      }

      function signOut(message?: string) {
        savedToken.forget();
        token = undefined;
        inquiries = undefined;
        groups.replaceChildren();
        forgetPhotos();
        showProblem(message);
        showPage();
      }

      /** Asks a function for something with the sign-in, signing out if the function refuses it. */
      async function ask(path: string, init: RequestInit = {}): Promise<Response | undefined> {
        let response: Response;
        try {
          response = await fetch(path, { ...init, headers: { ...init.headers, Authorization: `Bearer ${token}` } });
        } catch {
          return undefined;
        }
        if (response.status === 401 || response.status === 403) {
          const { message } = await response.json();
          const hint = response.status === 403 ? " Sign out of GitHub, then sign in with the account you use for the editor." : "";
          signOut(message + hint);
          throw new Error("signed out");
        }
        return response;
      }

      async function loadInquiries() {
        show("loading");
        showProblem();
        let response: Response | undefined;
        try {
          response = await ask("/api/inquiries");
        } catch {
          return;
        }
        if (!response) {
          show("nothing");
          showProblem("Couldn't reach the dashboard. Check your connection, then reload the page.");
          return;
        }
        if (!response.ok) {
          show("nothing");
          showProblem("Couldn't load Inquiries. Reload the page to try again.");
          return;
        }
        inquiries = await response.json();
        lastSaved.clear();
        showPage();
      }

      // Dates. An event date is a day with no time zone; the time an Inquiry arrived is shown in Toronto's.
      const day = (date: string, options: Intl.DateTimeFormatOptions) =>
        new Intl.DateTimeFormat("en-CA", { ...options, timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
      const receivedTime = (iso: string) =>
        new Intl.DateTimeFormat("en-CA", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Toronto" }).format(new Date(iso));

      function element<Tag extends keyof HTMLElementTagNameMap>(tag: Tag, className?: string, text?: string) {
        const created = document.createElement(tag);
        if (className) created.className = className;
        if (text !== undefined) created.textContent = text;
        return created;
      }

      /** An Inquiry status, as a tag when it's New and still needs a reply. */
      function statusOf(inquiry: Inquiry) {
        const status = element("span", "inquiry-status", inquiry.status);
        if (inquiry.status === "New") status.classList.add("inquiry-status-new");
        return status;
      }

      /** One row of the list: the event's date, who it's for, what it is and where it came from, and its Inquiry status. */
      function rowFor(inquiry: Inquiry, today: string) {
        const link = element("a", "inquiry-row");
        link.href = `?inquiry=${encodeURIComponent(inquiry.id)}`;
        link.dataset.inquiry = inquiry.id;

        const date = element("span", "inquiry-day");
        const what = [inquiry.eventType];
        if (inquiry.eventDate) {
          date.append(
            element("span", "inquiry-month", day(inquiry.eventDate, { month: "short" })),
            element("span", "inquiry-date", day(inquiry.eventDate, { day: "numeric" })),
          );
          // The year only when it isn't this one, written after the weekday ("Sat, 2027").
          const year = inquiry.eventDate.slice(0, 4);
          const weekday = day(inquiry.eventDate, { weekday: "short" });
          what.push(year === today.slice(0, 4) ? weekday : `${weekday}, ${year}`);
        }
        what.push(inquiry.source);

        const who = element("span", "inquiry-who");
        who.append(element("span", "inquiry-name", inquiry.name));
        const summary = what.filter(Boolean).join(" · ");
        if (summary) who.append(element("span", "inquiry-what", summary));

        link.append(date, who, statusOf(inquiry));
        const item = element("li");
        item.append(link);
        return item;
      }

      /** The Inquiry status the list is filtered to, kept in the address. Unknown or missing, it shows All. */
      const filteredTo = () => {
        const status = new URLSearchParams(location.search).get("status");
        return inquiryStatuses.find((known) => known === status);
      };

      /**
       * The list, in the order the function sends it: upcoming events, then past ones, then those with no
       * date. Above it, how many are New, whatever the filter shows.
       */
      function showList(list: Inquiry[]) {
        const today = torontoToday();
        const status = filteredTo();
        const shown = status ? list.filter((inquiry) => inquiry.status === status) : list;
        const newInquiries = list.filter((inquiry) => inquiry.status === "New").length;
        newCount.textContent = !newInquiries
          ? "No New Inquiries"
          : newInquiries === 1
            ? "1 New Inquiry"
            : `${newInquiries} New Inquiries`;
        newCount.classList.toggle("has-new", newInquiries > 0);
        listSaved.textContent = afterDeleting ?? "";
        afterDeleting = undefined;
        for (const button of filterButtons) button.setAttribute("aria-pressed", String(button.dataset.status === status));
        noneShown.hidden = shown.length > 0;
        noneShown.textContent = `No ${status} Inquiries`;

        const sections = new Map<EventTiming, HTMLUListElement>();
        for (const inquiry of shown) {
          const name = eventTiming(inquiry.eventDate, today);
          if (!sections.has(name)) sections.set(name, element("ul", "inquiry-list"));
          sections.get(name)!.append(rowFor(inquiry, today));
        }
        groups.replaceChildren(
          ...[...sections].map(([name, rows]) => {
            const section = element("section", "inquiry-group");
            const id = `group-${name.toLowerCase().replaceAll(" ", "-")}`;
            const title = element("h2", undefined, name);
            title.id = id;
            section.setAttribute("aria-labelledby", id);
            section.append(title, rows);
            return section;
          }),
        );
        empty.hidden = list.length > 0;
        overview.hidden = list.length === 0;
        show("list");
        // On a phone the chips are one row that swipes sideways, so the chosen one is brought to its middle.
        const pressed = filterButtons.find((button) => button.getAttribute("aria-pressed") === "true")!;
        filterRow.scrollTo({ left: pressed.offsetLeft - (filterRow.clientWidth - pressed.offsetWidth) / 2 });
      }

      /** A way to reach the customer, as a link to call or email them when it is a phone number or an email. */
      function contactFor(contact: string) {
        const digits = contact.replace(/\D/g, "");
        let href: string | undefined;
        if (/^\S+@\S+\.\S+$/.test(contact.trim())) href = `mailto:${contact.trim()}`;
        else if (/^[\d\s()+.-]+$/.test(contact) && digits.length >= 10) href = `tel:${contact.trim().startsWith("+") ? "+" : ""}${digits}`;
        if (!href) return document.createTextNode(contact);
        const link = element("a", undefined, contact);
        link.href = href;
        return link;
      }

      /**
       * Everything the customer sent, under the contact form's own labels. One the owner added by hand can
       * have its details edited.
       */
      function showDetail(inquiry: Inquiry) {
        const byHand = inquiry.source !== "Contact form";
        heading.textContent = inquiry.name;
        document.title = `${inquiry.name} · ${pageTitle}`;

        received.textContent = `${byHand ? "Added" : "Received"} ${receivedTime(inquiry.receivedAt)} · ${inquiry.source}`;
        showStatus(inquiry);
        notes.value = inquiry.notes ?? "";
        notesFor = inquiry.id;
        statusSaved.textContent = "";
        notesSaved.textContent = "";
        detailsSaved.textContent = afterSaving?.saved ?? "";
        if (afterSaving?.problem) showProblem(afterSaving.problem);
        afterSaving = undefined;
        answersHeading.textContent = byHand ? "Their details" : "What they sent";
        editLink.hidden = !byHand;
        editLink.href = `?edit=${encodeURIComponent(inquiry.id)}`;
        showDeleteConfirm(false);
        deleteHeading.textContent = `Delete the Inquiry from ${inquiry.name}?`;

        const rows: [string, string | Node | undefined][] = [
          [byHand ? "Phone, email or handle" : "Phone number or email", contactFor(inquiry.contact)],
          ["Event date", inquiry.eventDate && day(inquiry.eventDate, { dateStyle: "full" })],
          ["Venue or city", inquiry.venue],
          ["Event type", inquiry.eventType],
          ["Number of guests", inquiry.guests],
          ["Theme or colours", inquiry.theme],
          ["Décor wanted", inquiry.decor],
        ];
        answers.replaceChildren(
          ...rows.flatMap(([label, answer]) => {
            const value = element("dd");
            if (answer) value.append(answer);
            else value.append(element("span", "dashboard-quiet", "Not given"));
            return [element("dt", undefined, label), value];
          }),
        );

        photos.replaceChildren(
          ...(inquiry.photos.length
            ? inquiry.photos.map((photo, index) => photoFor(photo, `Inspiration photo ${index + 1} from ${inquiry.name}`))
            : [element("p", "dashboard-quiet", byHand ? "No photos added." : "No photos sent.")]),
        );
        show("detail");
      }

      // Changes are sent one at a time, in the order the owner makes them, so the last one made is the one kept.
      let saving = Promise.resolve(true);

      /** Each changed Inquiry as last saved, for going back to when a later change can't be saved. */
      const lastSaved = new Map<string, Inquiry>();

      /** Puts an Inquiry, as it now is, in place of the one the page had. */
      function replaceInquiry(changed: Inquiry) {
        inquiries = inquiries?.map((inquiry) => (inquiry.id === changed.id ? changed : inquiry));
      }

      const inquiryById = (id: string | null | undefined) => inquiries?.find((inquiry) => inquiry.id === id);

      /**
       * Saves a change to an Inquiry. The page shows it straight away, so going back to the list or opening
       * the Inquiry again shows it too, and goes back to what was saved if it can't be saved. True once saved.
       */
      function save(id: string, changes: InquiryChanges): Promise<boolean> {
        const shown = inquiryById(id);
        if (!shown) return Promise.resolve(false);
        // The first change to an Inquiry starts from it as loaded, which is as saved.
        if (!lastSaved.has(id)) lastSaved.set(id, shown);
        replaceInquiry({ ...shown, ...changes });
        saving = saving.then(async () => {
          const saved = await send(id, changes);
          if (saved) lastSaved.set(id, saved);
          // One deleted meanwhile is gone from the page, and stays gone.
          if (lastSaved.has(id)) replaceInquiry(lastSaved.get(id)!);
          return saved !== undefined;
        });
        return saving;
      }

      /** Sends a change to an Inquiry, and gives it back as it now is, or undefined if it wasn't saved. */
      const send = (id: string, changes: InquiryChanges) =>
        sendTo(`/api/inquiries/${encodeURIComponent(id)}`, "PATCH", JSON.stringify(changes));

      /**
       * Sends something to save to a function, as JSON or a form, and gives back the Inquiry it saved, or
       * undefined if it wasn't saved, saying why.
       */
      async function sendTo(path: string, method: "POST" | "PATCH", body: string | FormData): Promise<Inquiry | undefined> {
        let response: Response | undefined;
        try {
          const headers: HeadersInit = typeof body === "string" ? { "Content-Type": "application/json" } : {};
          response = await ask(path, { method, headers, body });
        } catch {
          return undefined;
        }
        if (!response) {
          showProblem("Couldn't reach the dashboard. Check your connection, then try again.");
          return undefined;
        }
        if (!response.ok) {
          const { message } = await response.json().catch(() => ({ message: "Try again." }));
          showProblem(`Couldn't save that. ${message}`);
          return undefined;
        }
        return response.json();
      }

      const statusInputs = [...statusChoice.querySelectorAll<HTMLInputElement>("input")];

      /** Ticks the Inquiry status an Inquiry is set to. */
      function showStatus(inquiry: Inquiry) {
        for (const input of statusInputs) input.checked = input.value === inquiry.status;
      }

      // A status is saved as soon as it's chosen. One that isn't saved goes back to the one that is.
      statusChoice.addEventListener("change", async (event) => {
        const id = openedId()!;
        const status = (event.target as HTMLInputElement).value as Inquiry["status"];
        showProblem();
        statusSaved.textContent = "";
        const done = await save(id, { status });
        if (openedId() !== id) return;
        if (done) statusSaved.textContent = `Set to ${status}`;
        const stored = inquiryById(id);
        if (stored) showStatus(stored);
      });

      /** The Inquiry whose notes are in the notes box. */
      let notesFor: string | undefined;

      /** Saves the notes as written for the Inquiry they're for, unless they're saved already. */
      function saveNotes(): Promise<boolean> {
        const stored = inquiryById(notesFor);
        if (!stored || notes.value === (stored.notes ?? "")) return saving;
        return save(stored.id, { notes: notes.value });
      }

      // Notes are saved with the button, and also on leaving the box or the Inquiry, so none are lost.
      notes.addEventListener("change", () => saveNotes());
      saveNotesButton.addEventListener("click", async () => {
        const id = notesFor;
        showProblem();
        notesSaved.textContent = "";
        const done = await saveNotes();
        if (done && openedId() === id) notesSaved.textContent = "Notes saved";
      });

      /** That an Inquiry was deleted, shown on the list it returns to. */
      let afterDeleting: string | undefined;

      /** Opens the step that asks before deleting the opened Inquiry, in place of its Delete button, or closes it. */
      function showDeleteConfirm(open: boolean) {
        deleteConfirm.hidden = !open;
        deleteButton.hidden = open;
      }

      deleteButton.addEventListener("click", () => {
        showDeleteConfirm(true);
        deleteConfirm.focus();
      });

      deleteCancel.addEventListener("click", () => {
        showDeleteConfirm(false);
        deleteButton.focus();
      });

      // A customer who just didn't book is kept as Declined, saved as if the owner had chosen it above.
      declineInstead.addEventListener("click", () => {
        showDeleteConfirm(false);
        const declined = statusInputs.find((input) => input.value === "Declined")!;
        declined.checked = true;
        declined.dispatchEvent(new Event("change", { bubbles: true }));
        declined.focus();
      });

      let deleting = false;

      deleteConfirmed.addEventListener("click", async () => {
        const inquiry = inquiryById(openedId());
        if (!inquiry || deleting) return;
        // Nothing else about it can be changed while it's being deleted.
        const whileDeleting = (busy: boolean) => {
          deleting = busy;
          for (const control of [deleteConfirmed, declineInstead, deleteCancel, statusChoice]) control.disabled = busy;
          notes.readOnly = busy;
        };
        whileDeleting(true);
        deleteConfirmed.textContent = "Deleting…";
        showProblem();
        try {
          // A status or notes change still being saved goes first, so it isn't sent for an Inquiry that's gone.
          await saving;
          let response: Response | undefined;
          try {
            response = await ask(`/api/inquiries/${encodeURIComponent(inquiry.id)}`, { method: "DELETE" });
          } catch {
            return;
          }
          if (!response) return showProblem("Couldn't reach the dashboard. Check your connection, then try again.");
          // One that isn't there any more is already gone, as asked.
          if (!response.ok && response.status !== 404) return showProblem("Couldn't delete it. Try again.");

          inquiries = inquiries?.filter(({ id }) => id !== inquiry.id);
          lastSaved.delete(inquiry.id);
          notesFor = undefined;
          for (const photo of inquiry.photos) {
            if (!("id" in photo)) continue;
            photoUrls.get(photo.id)?.then((loaded) => loaded && URL.revokeObjectURL(loaded));
            photoUrls.delete(photo.id);
          }
          afterDeleting = `Deleted the Inquiry from ${inquiry.name}`;
          // Back to the list it was opened from, so going back doesn't lead to the Inquiry that's gone.
          if (history.state?.fromList) {
            addEventListener("popstate", () => heading.focus({ preventScroll: true }), { once: true });
            return history.back();
          }
          history.replaceState({}, "", back.href);
          showPage();
          heading.focus({ preventScroll: true });
        } finally {
          whileDeleting(false);
          deleteConfirmed.textContent = "Delete for good";
        }
      });

      // Photos are served only with the sign-in, which an image element can't send, so the page fetches each one
      // and shows it from memory. They're kept until signing out, so going back and forth doesn't refetch.
      const photoUrls = new Map<string, Promise<string | undefined>>();

      function forgetPhotos() {
        for (const url of photoUrls.values()) url.then((loaded) => loaded && URL.revokeObjectURL(loaded));
        photoUrls.clear();
      }

      function photoUrl(id: string) {
        if (!photoUrls.has(id)) {
          const loading = ask(`/api/inquiry-photos/${encodeURIComponent(id)}`)
            .then(async (response) => (response?.ok ? URL.createObjectURL(await response.blob()) : undefined))
            .catch(() => undefined);
          photoUrls.set(id, loading);
          // One that didn't load is asked for again next time.
          loading.then((loaded) => loaded || photoUrls.delete(id));
        }
        return photoUrls.get(id)!;
      }

      function photoFor(photo: InquiryPhoto, alt: string) {
        const figure = element("figure", "inquiry-photo");
        const caption = element("figcaption", undefined, photo.name);
        if ("missing" in photo) {
          figure.classList.add("inquiry-photo-missing");
          figure.append(element("p", undefined, "This photo couldn't be saved. It's still in the email."), caption);
          return figure;
        }
        const frame = element("div", "inquiry-photo-frame");
        figure.append(frame, caption);
        photoUrl(photo.id).then((url) => {
          if (!url) {
            frame.append(element("p", undefined, "This photo didn't load. Reload the page to try again."));
            return;
          }
          const image = element("img");
          image.alt = alt;
          image.src = url;
          frame.classList.add("is-loaded");
          frame.append(image);
        });
        return figure;
      }

      /** The id of the Inquiry the address opens, if it opens one. */
      const openedId = () => new URLSearchParams(location.search).get("inquiry");

      /** What the address asks the form for: adding an Inquiry, or editing the details of the one with this id. */
      function formAsked(): { adding: true } | { editing: string } | undefined {
        const asked = new URLSearchParams(location.search);
        if (asked.has("add")) return { adding: true };
        const editing = asked.get("edit");
        return editing ? { editing } : undefined;
      }

      /** Shows what the address asks for: the list, one Inquiry, or the form. */
      function showPage() {
        saveNotes();
        notesFor = undefined;
        const opened = openedId();
        const asked = formAsked();
        back.hidden = (!opened && !asked) || !token;
        heading.textContent = "Inquiries";
        document.title = pageTitle;
        if (!token) return show("signed-out");
        if (!inquiries) return;

        if (asked && "adding" in asked) return showForm();
        const inquiry = inquiryById(opened ?? (asked && asked.editing));
        if (!opened && !asked) return showList(inquiries);
        // A contact-form Inquiry keeps the customer's answers, so it has no form to edit them.
        if (inquiry && asked) return inquiry.source === "Contact form" ? showDetail(inquiry) : showForm(inquiry);
        if (inquiry) return showDetail(inquiry);
        show("nothing");
        showProblem("This Inquiry isn't here any more.");
      }

      /** A click that opens a link here, rather than in a new tab or window. */
      const opensHere = (event: MouseEvent) => !event.metaKey && !event.ctrlKey && !event.shiftKey && event.button === 0;

      /**
       * Shows a link's page on this page, as if it were opened. Where it was opened from is kept in `state`,
       * so going back can return there, and the page left keeps its place.
       */
      function openHere(href: string, state: { fromList?: true; fromInquiry?: true }) {
        history.replaceState({ ...history.state, scroll: scrollY }, "");
        history.pushState(state, "", href);
        showProblem();
        showPage();
        scrollTo(0, 0);
        heading.focus({ preventScroll: true });
      }

      // Opening an Inquiry, adding one or editing one and coming back stay on this page, and the list keeps its place.
      groups.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-inquiry]");
        if (!link || !opensHere(event)) return;
        event.preventDefault();
        openHere(link.href, { fromList: true });
      });

      addLink.addEventListener("click", (event) => {
        if (!opensHere(event)) return;
        event.preventDefault();
        openHere(addLink.href, { fromList: true });
      });

      editLink.addEventListener("click", (event) => {
        if (!opensHere(event)) return;
        event.preventDefault();
        openHere(editLink.href, { fromInquiry: true });
      });

      // The form: adding an Inquiry from an Instagram or Facebook message, or editing one's details.


      /** What happens after the form saves, shown on the Inquiry it saved: that it's saved, and any photo that wasn't. */
      let afterSaving: { saved: string; problem?: string } | undefined;

      /** The Inquiry whose details the form is editing, or undefined when it's adding one. */
      let editing: Inquiry | undefined;

      /** How many more photos the Inquiry in the form can take. */
      const photoRoom = () => Number(photoInput.dataset.max) - (editing?.photos.length ?? 0);

      /** The form, empty for adding an Inquiry, or holding the details of the one it edits. */
      function showForm(inquiry?: Inquiry) {
        editing = inquiry;
        heading.textContent = inquiry ? "Edit details" : "Add an Inquiry";
        document.title = `${inquiry ? `${inquiry.name}: edit details` : "Add an Inquiry"} · ${pageTitle}`;
        form.reset();
        for (const field of form.querySelectorAll<HTMLInputElement>("[aria-invalid]")) showFieldError(field, "");
        showFieldError(photoInput, "");
        // An Event type the owner has since renamed or removed is still offered, so editing keeps it.
        eventTypeChoice.querySelector("[data-kept]")?.remove();
        if (inquiry) {
          const fields = form.elements;
          (fields.namedItem("source") as RadioNodeList).value = inquiry.source;
          if (inquiry.eventType && ![...eventTypeChoice.options].some((option) => option.value === inquiry.eventType)) {
            const kept = element("option", undefined, inquiry.eventType);
            kept.dataset.kept = "";
            eventTypeChoice.append(kept);
          }
          for (const name of customerAnswers) (fields.namedItem(name) as HTMLInputElement).value = inquiry[name] ?? "";
        }

        const room = photoRoom();
        photoField.hidden = room <= 0;
        photoHint.textContent = `${inquiry?.photos.length ? `Up to ${room} more` : `Up to ${room}`} ${room === 1 ? "image" : "images"}, such as screenshots of the chat.`;
        submitButton.textContent = inquiry ? "Save details" : "Add Inquiry";
        cancelLink.href = inquiry ? `?inquiry=${encodeURIComponent(inquiry.id)}` : "/admin/inquiries/";
        show("form");
      }

      /** Shows the message in the line under the field, or clears it when the message is empty. */
      function showFieldError(field: HTMLInputElement, message: string) {
        document.getElementById(`${field.id}-error`)!.textContent = message;
        if (message) field.setAttribute("aria-invalid", "true");
        else field.removeAttribute("aria-invalid");
      }

      /** The message a field's value needs, or empty if it's fine. */
      function problemWith(field: HTMLInputElement): string {
        if (field.type === "file") {
          const room = photoRoom();
          return field.files!.length > room ? `Choose up to ${room} ${room === 1 ? "image" : "images"}.` : "";
        }
        if (field.dataset.missing && !field.value.trim()) return field.dataset.missing;
        if (field.dataset.invalid && !field.validity.valid) return field.dataset.invalid;
        return "";
      }

      const checkedFields = [...form.querySelectorAll<HTMLInputElement>("[data-missing], [data-invalid]"), photoInput];

      /** Shows each field's message, and moves to the first that needs fixing. True when none does. */
      function formIsReady(): boolean {
        let first: HTMLInputElement | undefined;
        for (const field of checkedFields) {
          const message = problemWith(field);
          showFieldError(field, message);
          if (message) first ??= field;
        }
        first?.focus();
        return !first;
      }

      // A field with a message is checked again as the owner fixes it.
      for (const field of checkedFields) {
        field.addEventListener(field.type === "file" ? "change" : "input", () => {
          if (field.hasAttribute("aria-invalid")) showFieldError(field, problemWith(field));
        });
      }

      /** The form's details and where the Inquiry came from, as the Inquiries module takes them. */
      function detailsInForm(): NewInquiry {
        const data = new FormData(form);
        return Object.fromEntries(["source", ...customerAnswers].map((name) => [name, String(data.get(name) ?? "")])) as NewInquiry;
      }

      /** Attaches each photo to the Inquiry, one at a time. Gives back the names of any that weren't saved. */
      async function attachPhotos(id: string, files: File[]): Promise<string[]> {
        const notSaved: string[] = [];
        for (const file of files) {
          const body = new FormData();
          body.set("photo", file);
          const saved = await sendTo(`/api/inquiries/${encodeURIComponent(id)}/photos`, "POST", body);
          if (saved) savedAs(saved);
          else notSaved.push(file.name);
        }
        return notSaved;
      }

      /** Keeps an Inquiry as it was just saved, in its place in the list. */
      function savedAs(saved: Inquiry) {
        lastSaved.set(saved.id, saved);
        inquiries = [...(inquiries ?? []).filter((inquiry) => inquiry.id !== saved.id), saved].sort(inListOrder(torontoToday()));
      }

      const photosNotSaved = (names: string[]) =>
        names.length ? `Couldn't save ${names.join(", ")}. Choose Edit details to add ${names.length === 1 ? "it" : "them"} again.` : undefined;

      /**
       * Leaves the form for the page it returns to. Going back returns there when the form was opened from it,
       * so the back button doesn't lead to the form again.
       */
      function leaveForm(to: string, openedFrom: boolean) {
        if (openedFrom) return history.back();
        history.replaceState({}, "", to);
        showProblem();
        showPage();
      }

      let formSaving = false;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (formSaving || !formIsReady()) return;
        const inquiry = editing;
        const details = detailsInForm();
        const photos = [...photoInput.files!];
        formSaving = true;
        submitButton.disabled = true;
        submitButton.textContent = inquiry ? "Saving…" : "Adding…";
        showProblem();
        try {
          // A status or notes change still being saved goes first, so this one is kept after it.
          await saving;
          const saved = inquiry ? await send(inquiry.id, details) : await sendTo("/api/inquiries", "POST", JSON.stringify(details));
          if (!saved) return;
          savedAs(saved);
          afterSaving = { saved: inquiry ? "Details saved" : "Inquiry added", problem: photosNotSaved(await attachPhotos(saved.id, photos)) };
          const opened = `?inquiry=${encodeURIComponent(saved.id)}`;
          if (inquiry) return leaveForm(opened, history.state?.fromInquiry);
          // A new Inquiry opens in place of the form, so going back from it returns to the list.
          history.replaceState({ fromList: history.state?.fromList }, "", opened);
          showPage();
          scrollTo(0, 0);
          heading.focus({ preventScroll: true });
        } finally {
          formSaving = false;
          submitButton.disabled = false;
          submitButton.textContent = inquiry ? "Save details" : "Add Inquiry";
        }
      });

      cancelLink.addEventListener("click", (event) => {
        if (!opensHere(event)) return;
        event.preventDefault();
        leaveForm(cancelLink.href, editing ? history.state?.fromInquiry : history.state?.fromList);
      });

      // Coming from the list, going back returns to it where it was left. Opened straight from a link, it opens the list.
      back.addEventListener("click", (event) => {
        if (!opensHere(event)) return;
        event.preventDefault();
        if (history.state?.fromList) return history.back();
        history.pushState({}, "", back.href);
        showProblem();
        showPage();
      });

      addEventListener("popstate", () => {
        showProblem();
        showPage();
        scrollTo(0, history.state?.scroll ?? 0);
      });

      signInButton.addEventListener("click", async () => {
        showProblem();
        try {
          const signedIn = await signInWithGitHub();
          if (!signedIn) return;
          savedToken.save(signedIn);
          token = signedIn;
          await loadInquiries();
        } catch (error) {
          showProblem((error as Error).message);
        }
      });

      signOutButton.addEventListener("click", () => signOut());

      // The filter is kept in the address, so a reload, or coming back from an Inquiry, keeps it.
      for (const button of filterButtons) {
        button.addEventListener("click", () => {
          const url = new URL(location.href);
          if (button.dataset.status) url.searchParams.set("status", button.dataset.status);
          else url.searchParams.delete("status");
          history.replaceState(history.state, "", url);
          showList(inquiries ?? []);
          // Announced only when the owner chooses, not on load.
          const shown = groups.querySelectorAll(".inquiry-row").length;
          filterStatus.textContent = `Showing ${shown} ${shown === 1 ? "Inquiry" : "Inquiries"}`;
        });
      }

      heading.tabIndex = -1;
      token = savedToken.read();
      if (token) loadInquiries();
      else showPage();
    </script>
  </body>
</html>

<style is:global>
  /* Global, as the script builds the list and an opened Inquiry, which Astro's scoped styles wouldn't reach.
     Only this page loads them. */
  .dashboard-bar {
    border-bottom: 1px solid var(--color-line);
  }

  .dashboard-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4rem;
  }

  .dashboard-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .dashboard-nav {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-sm);
  }

  /* A pill sets its own display, which would otherwise show the Sign out button while signed out. */
  .dashboard-nav .pill[hidden] {
    display: none;
  }

  .dashboard-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
  }

  .dashboard {
    padding-block: var(--space-lg) var(--space-xl);
  }

  .dashboard h1 {
    font-size: var(--text-xl);
  }

  .dashboard h1:focus {
    outline: none;
  }

  .dashboard-back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.75rem;
    margin-inline-start: -0.25rem;
    font-size: var(--text-sm);
  }

  .dashboard-back[hidden] {
    display: none;
  }

  .dashboard-back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dashboard-back + h1 {
    margin-block-start: var(--space-xs);
  }

  .dashboard-problem {
    color: var(--color-error);
  }

  .dashboard-problem:empty {
    display: none;
  }

  .dashboard-quiet {
    color: var(--color-text-muted);
  }

  .dashboard-empty {
    padding: var(--space-lg) var(--space-md);
    border-radius: var(--radius);
    background: var(--color-sage-band);
    text-align: center;
  }

  .dashboard-empty p {
    margin-inline: auto;
  }

  .dashboard-empty-title {
    margin-block: 0 var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .dashboard-empty .dashboard-quiet {
    margin-block-end: 0;
  }

  /* Above the list: how many Inquiries are New, then the filter by Inquiry status, its pills like the gallery's. */
  .inquiry-overview {
    max-width: 44rem;
    margin-block-end: var(--space-lg);
  }

  .inquiry-overview[hidden] {
    display: none;
  }

  .inquiry-new-count {
    margin-block: 0 var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  /* While anyone is waiting on a reply, the count is set in full ink rather than muted. */
  .inquiry-new-count.has-new {
    color: var(--color-text);
    font-weight: 500;
  }

  .inquiry-filter {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  /* On a phone the chips stay on one row that swipes sideways, as in the gallery, running out to the
     screen's edges so the last chip in view is cut off there. Its block padding keeps focus rings whole. */
  @media (max-width: 47.99rem) {
    .inquiry-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      margin: calc(-1 * var(--space-xs)) calc(-1 * var(--gutter));
      padding: var(--space-xs) var(--gutter);
      scroll-padding-inline: var(--gutter);
    }

    .inquiry-filter::-webkit-scrollbar {
      display: none;
    }

    .inquiry-filter .pill {
      flex: none;
      scroll-snap-align: start;
    }
  }

  .inquiry-overview [data-none-shown] {
    margin-block: var(--space-md) 0;
  }

  /* The list: a group for upcoming events, past ones and those with no date, each a run of hairline rows. */
  .inquiry-group {
    max-width: 44rem;
  }

  .inquiry-group + .inquiry-group {
    margin-block-start: var(--space-lg);
  }

