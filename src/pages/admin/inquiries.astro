---
import "@fontsource-variable/cormorant-garamond";
import "@fontsource-variable/jost";
import "../../styles/tokens.css";
import "../../styles/global.css";
import { inquiryStatuses } from "../../inquiry-statuses";
import { siteName } from "../../site-settings";

// The Inquiry dashboard (ADR 0004): a static page whose script signs the owner in with GitHub through
// Netlify's OAuth provider, the same login as the editor, and asks the Inquiry functions for Inquiries.
// The functions decide who may see them; this page only keeps the sign-in and shows what they send.
// The list and an opened Inquiry are both this page: an opened one is `?inquiry=<id>`, so the phone's
// back button and a reload both work.
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Inquiries · {siteName}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="dashboard-bar">
      <div class="container dashboard-bar-inner">
        <span class="dashboard-name">{siteName}</span>
        <nav aria-label="Owner pages" class="dashboard-nav">
          <a class="link-line" href="/admin/">Editor</a>
          <button type="button" class="pill" data-sign-out hidden>Sign out</button>
        </nav>
      </div>
    </header>

    <main id="main" class="container dashboard">
      <a class="dashboard-back link-line" href="/admin/inquiries/" data-back hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" /></svg>
        All Inquiries
      </a>
      <h1 data-heading>Inquiries</h1>
      <p role="alert" class="dashboard-problem" data-problem></p>

      <section data-view="signed-out" class="dashboard-sign-in">
        <p>Sign in with the GitHub account you use for the editor.</p>
        <button type="button" class="pill pill-solid" data-sign-in>Sign in with GitHub</button>
      </section>

      <p data-view="loading" class="dashboard-quiet" hidden>Loading Inquiries…</p>

      <section data-view="list" hidden>
        <div data-empty class="dashboard-empty" hidden>
          <p class="dashboard-empty-title">No Inquiries yet</p>
          <p class="dashboard-quiet">Each Inquiry sent through the contact form will appear here.</p>
        </div>
        <div data-overview class="inquiry-overview">
          <p class="inquiry-new-count" data-new-count></p>
          <div class="inquiry-filter" role="group" aria-label="Filter by Inquiry status">
            <button type="button" class="pill" aria-pressed="true">All</button>
            {
              inquiryStatuses.map((status) => (
                <button type="button" class="pill" aria-pressed="false" data-status={status}>
                  {status}
                </button>
              ))
            }
          </div>
          <p class="visually-hidden" role="status" data-filter-status></p>
          <p class="dashboard-quiet" data-none-shown hidden></p>
        </div>
        <div data-groups></div>
      </section>

      <article data-view="detail" class="inquiry" hidden>
        <p class="inquiry-received" data-received></p>
        <fieldset class="inquiry-status-choice" data-status-choice>
          <legend>Inquiry status</legend>
          <div class="inquiry-status-options">
            {
              inquiryStatuses.map((status) => (
                <label class="pill">
                  <input type="radio" name="status" value={status} />
                  {status}
                </label>
              ))
            }
          </div>
        </fieldset>
        <p role="status" class="inquiry-saved" data-status-saved></p>
        <div class="inquiry-notes">
          <label for="inquiry-notes">Notes</label>
          <textarea id="inquiry-notes" rows="4" data-notes></textarea>
          <div class="inquiry-notes-save">
            <button type="button" class="pill" data-save-notes>Save notes</button>
            <p role="status" class="inquiry-saved" data-notes-saved></p>
          </div>
        </div>
        <h2>What they sent</h2>
        <dl class="inquiry-answers" data-answers></dl>
        <h2>Inspiration photos</h2>
        <div class="inquiry-photos" data-photos></div>
      </article>
    </main>

    <script>
      import type { Inquiry, InquiryChanges, InquiryPhoto } from "../../../netlify/inquiries";
      import { eventTiming, torontoToday, type EventTiming } from "../../inquiry-dates";
      import { inquiryStatuses } from "../../inquiry-statuses";

      /** Netlify's OAuth provider, which the editor signs in through too. */
      const netlify = "https://api.netlify.com";
      const tokenKey = "likha-inquiry-dashboard.github-token";
      const pageTitle = document.title;

      const views = document.querySelectorAll<HTMLElement>("[data-view]");
      const heading = document.querySelector<HTMLElement>("[data-heading]")!;
      const back = document.querySelector<HTMLAnchorElement>("[data-back]")!;
      const problem = document.querySelector<HTMLElement>("[data-problem]")!;
      const signInButton = document.querySelector<HTMLButtonElement>("[data-sign-in]")!;
      const signOutButton = document.querySelector<HTMLButtonElement>("[data-sign-out]")!;
      const empty = document.querySelector<HTMLElement>("[data-empty]")!;
      const groups = document.querySelector<HTMLElement>("[data-groups]")!;
      const received = document.querySelector<HTMLElement>("[data-received]")!;
      const answers = document.querySelector<HTMLElement>("[data-answers]")!;
      const photos = document.querySelector<HTMLElement>("[data-photos]")!;
      const overview = document.querySelector<HTMLElement>("[data-overview]")!;
      const newCount = document.querySelector<HTMLElement>("[data-new-count]")!;
      const filterRow = document.querySelector<HTMLElement>(".inquiry-filter")!;
      const filterButtons = [...filterRow.querySelectorAll("button")];
      const filterStatus = document.querySelector<HTMLElement>("[data-filter-status]")!;
      const noneShown = document.querySelector<HTMLElement>("[data-none-shown]")!;
      const statusChoice = document.querySelector<HTMLFieldSetElement>("[data-status-choice]")!;
      const statusSaved = document.querySelector<HTMLElement>("[data-status-saved]")!;
      const notes = document.querySelector<HTMLTextAreaElement>("[data-notes]")!;
      const saveNotesButton = document.querySelector<HTMLButtonElement>("[data-save-notes]")!;
      const notesSaved = document.querySelector<HTMLElement>("[data-notes-saved]")!;

      // The sign-in is kept in this browser so the owner stays signed in on their phone. Storage can be
      // blocked, as in a private window, and then the owner signs in each visit.
      const savedToken = {
        read: () => {
          try {
            return localStorage.getItem(tokenKey) ?? undefined;
          } catch {
            return undefined;
          }
        },
        save: (token: string) => {
          try {
            localStorage.setItem(tokenKey, token);
          } catch {}
        },
        forget: () => {
          try {
            localStorage.removeItem(tokenKey);
          } catch {}
        },
      };

      /** The signed-in owner's GitHub token, and the Inquiries the list function last sent. */
      let token: string | undefined;
      let inquiries: Inquiry[] | undefined;

      function show(view: "signed-out" | "loading" | "list" | "detail" | "nothing") {
        for (const element of views) element.hidden = element.dataset.view !== view;
        signOutButton.hidden = view === "signed-out";
      }

      function showProblem(message = "") {
        problem.textContent = message;
      }

      /** The GitHub token in the details Netlify's sign-in window hands back, if they hold one. */
      function tokenFrom(details: string): string | undefined {
        try {
          const { token } = JSON.parse(details);
          return typeof token === "string" && token ? token : undefined;
        } catch {
          return undefined;
        }
      }

      /**
       * Opens Netlify's GitHub sign-in window and waits for the GitHub token it hands back, after the
       * handshake Netlify's window expects. Undefined if the window is closed first.
       */
      function signInWithGitHub(): Promise<string | undefined> {
        // Netlify finds the site's GitHub settings by its domain, which a local copy of the site doesn't have.
        const local = ["localhost", "127.0.0.1"].includes(location.hostname);
        const siteId = local ? new URL(import.meta.env.SITE).host : location.host;
        const url = `${netlify}/auth?provider=github&site_id=${encodeURIComponent(siteId)}&scope=repo`;
        const popup = open(url, "github-sign-in", "width=960,height=640");
        if (!popup) return Promise.reject(new Error("Allow pop-ups for this site, then sign in again."));

        return new Promise((resolve, reject) => {
          const finish = () => {
            removeEventListener("message", onMessage);
            clearInterval(closedCheck);
            popup.close();
          };
          const onMessage = (event: MessageEvent) => {
            if (event.origin !== netlify || event.source !== popup || typeof event.data !== "string") return;
            if (event.data === "authorizing:github") {
              popup.postMessage(event.data, event.origin);
              return;
            }
            const success = event.data.match(/^authorization:github:success:(.+)$/s);
            if (!success && !event.data.startsWith("authorization:github:error:")) return;
            finish();
            const token = success && tokenFrom(success[1]);
            if (token) resolve(token);
            else reject(new Error("GitHub didn't sign you in. Try again."));
          };
          const closedCheck = setInterval(() => {
            if (!popup.closed) return;
            finish();
            resolve(undefined);
          }, 500);
          addEventListener("message", onMessage);
        });
      }

      function signOut(message?: string) {
        savedToken.forget();
        token = undefined;
        inquiries = undefined;
        groups.replaceChildren();
        forgetPhotos();
        showProblem(message);
        showPage();
      }

      /** Asks a function for something with the sign-in, signing out if the function refuses it. */
      async function ask(path: string, init: RequestInit = {}): Promise<Response | undefined> {
        let response: Response;
        try {
          response = await fetch(path, { ...init, headers: { ...init.headers, Authorization: `Bearer ${token}` } });
        } catch {
          return undefined;
        }
        if (response.status === 401 || response.status === 403) {
          const { message } = await response.json();
          const hint = response.status === 403 ? " Sign out of GitHub, then sign in with the account you use for the editor." : "";
          signOut(message + hint);
          throw new Error("signed out");
        }
        return response;
      }

      async function loadInquiries() {
        show("loading");
        showProblem();
        let response: Response | undefined;
        try {
          response = await ask("/api/inquiries");
        } catch {
          return;
        }
        if (!response) {
          show("nothing");
          showProblem("Couldn't reach the dashboard. Check your connection, then reload the page.");
          return;
        }
        if (!response.ok) {
          show("nothing");
          showProblem("Couldn't load Inquiries. Reload the page to try again.");
          return;
        }
        inquiries = await response.json();
        lastSaved.clear();
        showPage();
      }

      // Dates. An event date is a day with no time zone; the time an Inquiry arrived is shown in Toronto's.
      const day = (date: string, options: Intl.DateTimeFormatOptions) =>
        new Intl.DateTimeFormat("en-CA", { ...options, timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
      const receivedTime = (iso: string) =>
        new Intl.DateTimeFormat("en-CA", { dateStyle: "medium", timeStyle: "short", timeZone: "America/Toronto" }).format(new Date(iso));

      function element<Tag extends keyof HTMLElementTagNameMap>(tag: Tag, className?: string, text?: string) {
        const created = document.createElement(tag);
        if (className) created.className = className;
        if (text !== undefined) created.textContent = text;
        return created;
      }

      /** An Inquiry status, as a tag when it's New and still needs a reply. */
      function statusOf(inquiry: Inquiry) {
        const status = element("span", "inquiry-status", inquiry.status);
        if (inquiry.status === "New") status.classList.add("inquiry-status-new");
        return status;
      }

      /** One row of the list: the event's date, who it's for and what it is, and its Inquiry status. */
      function rowFor(inquiry: Inquiry, today: string) {
        const link = element("a", "inquiry-row");
        link.href = `?inquiry=${encodeURIComponent(inquiry.id)}`;
        link.dataset.inquiry = inquiry.id;

        const date = element("span", "inquiry-day");
        const what = [inquiry.eventType];
        if (inquiry.eventDate) {
          date.append(
            element("span", "inquiry-month", day(inquiry.eventDate, { month: "short" })),
            element("span", "inquiry-date", day(inquiry.eventDate, { day: "numeric" })),
          );
          // The year only when it isn't this one, written after the weekday ("Sat, 2027").
          const year = inquiry.eventDate.slice(0, 4);
          const weekday = day(inquiry.eventDate, { weekday: "short" });
          what.push(year === today.slice(0, 4) ? weekday : `${weekday}, ${year}`);
        }

        const who = element("span", "inquiry-who");
        who.append(element("span", "inquiry-name", inquiry.name));
        const summary = what.filter(Boolean).join(" · ");
        if (summary) who.append(element("span", "inquiry-what", summary));

        link.append(date, who, statusOf(inquiry));
        const item = element("li");
        item.append(link);
        return item;
      }

      /** The Inquiry status the list is filtered to, kept in the address. Unknown or missing, it shows All. */
      const filteredTo = () => {
        const status = new URLSearchParams(location.search).get("status");
        return inquiryStatuses.find((known) => known === status);
      };

      /**
       * The list, in the order the function sends it: upcoming events, then past ones, then those with no
       * date. Above it, how many are New, whatever the filter shows.
       */
      function showList(list: Inquiry[]) {
        const today = torontoToday();
        const status = filteredTo();
        const shown = status ? list.filter((inquiry) => inquiry.status === status) : list;
        const newInquiries = list.filter((inquiry) => inquiry.status === "New").length;
        newCount.textContent = !newInquiries
          ? "No New Inquiries"
          : newInquiries === 1
            ? "1 New Inquiry"
            : `${newInquiries} New Inquiries`;
        newCount.classList.toggle("has-new", newInquiries > 0);
        for (const button of filterButtons) button.setAttribute("aria-pressed", String(button.dataset.status === status));
        noneShown.hidden = shown.length > 0;
        noneShown.textContent = `No ${status} Inquiries`;

        const sections = new Map<EventTiming, HTMLUListElement>();
        for (const inquiry of shown) {
          const name = eventTiming(inquiry.eventDate, today);
          if (!sections.has(name)) sections.set(name, element("ul", "inquiry-list"));
          sections.get(name)!.append(rowFor(inquiry, today));
        }
        groups.replaceChildren(
          ...[...sections].map(([name, rows]) => {
            const section = element("section", "inquiry-group");
            const id = `group-${name.toLowerCase().replaceAll(" ", "-")}`;
            const title = element("h2", undefined, name);
            title.id = id;
            section.setAttribute("aria-labelledby", id);
            section.append(title, rows);
            return section;
          }),
        );
        empty.hidden = list.length > 0;
        overview.hidden = list.length === 0;
        show("list");
        // On a phone the chips are one row that swipes sideways, so the chosen one is brought to its middle.
        const pressed = filterButtons.find((button) => button.getAttribute("aria-pressed") === "true")!;
        filterRow.scrollTo({ left: pressed.offsetLeft - (filterRow.clientWidth - pressed.offsetWidth) / 2 });
      }

      /** A way to reach the customer, as a link to call or email them when it is a phone number or an email. */
      function contactFor(contact: string) {
        const digits = contact.replace(/\D/g, "");
        let href: string | undefined;
        if (/^\S+@\S+\.\S+$/.test(contact.trim())) href = `mailto:${contact.trim()}`;
        else if (/^[\d\s()+.-]+$/.test(contact) && digits.length >= 10) href = `tel:${contact.trim().startsWith("+") ? "+" : ""}${digits}`;
        if (!href) return document.createTextNode(contact);
        const link = element("a", undefined, contact);
        link.href = href;
        return link;
      }

      /** Everything the customer sent, under the contact form's own labels. */
      function showDetail(inquiry: Inquiry) {
        heading.textContent = inquiry.name;
        document.title = `${inquiry.name} · ${pageTitle}`;

        received.textContent = `Received ${receivedTime(inquiry.receivedAt)} · ${inquiry.source}`;
        showStatus(inquiry);
        notes.value = inquiry.notes ?? "";
        notesFor = inquiry.id;
        statusSaved.textContent = "";
        notesSaved.textContent = "";

        const rows: [string, string | Node | undefined][] = [
          ["Phone number or email", contactFor(inquiry.contact)],
          ["Event date", inquiry.eventDate && day(inquiry.eventDate, { dateStyle: "full" })],
          ["Venue or city", inquiry.venue],
          ["Event type", inquiry.eventType],
          ["Number of guests", inquiry.guests],
          ["Theme or colours", inquiry.theme],
          ["Décor wanted", inquiry.decor],
        ];
        answers.replaceChildren(
          ...rows.flatMap(([label, answer]) => {
            const value = element("dd");
            if (answer) value.append(answer);
            else value.append(element("span", "dashboard-quiet", "Not given"));
            return [element("dt", undefined, label), value];
          }),
        );

        photos.replaceChildren(
          ...(inquiry.photos.length
            ? inquiry.photos.map((photo, index) => photoFor(photo, `Inspiration photo ${index + 1} from ${inquiry.name}`))
            : [element("p", "dashboard-quiet", "No photos sent.")]),
        );
        show("detail");
      }

      // Changes are sent one at a time, in the order the owner makes them, so the last one made is the one kept.
      let saving = Promise.resolve(true);

      /** Each changed Inquiry as last saved, for going back to when a later change can't be saved. */
      const lastSaved = new Map<string, Inquiry>();

      /** Puts an Inquiry, as it now is, in place of the one the page had. */
      function replaceInquiry(changed: Inquiry) {
        inquiries = inquiries?.map((inquiry) => (inquiry.id === changed.id ? changed : inquiry));
      }

      const inquiryById = (id: string | null | undefined) => inquiries?.find((inquiry) => inquiry.id === id);

      /**
       * Saves a change to an Inquiry. The page shows it straight away, so going back to the list or opening
       * the Inquiry again shows it too, and goes back to what was saved if it can't be saved. True once saved.
       */
      function save(id: string, changes: InquiryChanges): Promise<boolean> {
        const shown = inquiryById(id);
        if (!shown) return Promise.resolve(false);
        // The first change to an Inquiry starts from it as loaded, which is as saved.
        if (!lastSaved.has(id)) lastSaved.set(id, shown);
        replaceInquiry({ ...shown, ...changes });
        saving = saving.then(async () => {
          const saved = await send(id, changes);
          if (saved) lastSaved.set(id, saved);
          replaceInquiry(lastSaved.get(id)!);
          return saved !== undefined;
        });
        return saving;
      }

      /** Sends a change to an Inquiry, and gives it back as it now is, or undefined if it wasn't saved. */
      async function send(id: string, changes: InquiryChanges): Promise<Inquiry | undefined> {
        let response: Response | undefined;
        try {
          response = await ask(`/api/inquiries/${encodeURIComponent(id)}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(changes),
          });
        } catch {
          return undefined;
        }
        if (!response) {
          showProblem("Couldn't reach the dashboard. Check your connection, then try again.");
          return undefined;
        }
        if (!response.ok) {
          const { message } = await response.json().catch(() => ({ message: "Try again." }));
          showProblem(`Couldn't save that. ${message}`);
          return undefined;
        }
        return response.json();
      }

      const statusInputs = [...statusChoice.querySelectorAll<HTMLInputElement>("input")];

      /** Ticks the Inquiry status an Inquiry is set to. */
      function showStatus(inquiry: Inquiry) {
        for (const input of statusInputs) input.checked = input.value === inquiry.status;
      }

      // A status is saved as soon as it's chosen. One that isn't saved goes back to the one that is.
      statusChoice.addEventListener("change", async (event) => {
        const id = openedId()!;
        const status = (event.target as HTMLInputElement).value as Inquiry["status"];
        showProblem();
        statusSaved.textContent = "";
        const done = await save(id, { status });
        if (openedId() !== id) return;
        if (done) statusSaved.textContent = `Set to ${status}`;
        const stored = inquiryById(id);
        if (stored) showStatus(stored);
      });

      /** The Inquiry whose notes are in the notes box. */
      let notesFor: string | undefined;

      /** Saves the notes as written for the Inquiry they're for, unless they're saved already. */
      function saveNotes(): Promise<boolean> {
        const stored = inquiryById(notesFor);
        if (!stored || notes.value === (stored.notes ?? "")) return saving;
        return save(stored.id, { notes: notes.value });
      }

      // Notes are saved with the button, and also on leaving the box or the Inquiry, so none are lost.
      notes.addEventListener("change", () => saveNotes());
      saveNotesButton.addEventListener("click", async () => {
        const id = notesFor;
        showProblem();
        notesSaved.textContent = "";
        const done = await saveNotes();
        if (done && openedId() === id) notesSaved.textContent = "Notes saved";
      });

      // Photos are served only with the sign-in, which an image element can't send, so the page fetches each one
      // and shows it from memory. They're kept until signing out, so going back and forth doesn't refetch.
      const photoUrls = new Map<string, Promise<string | undefined>>();

      function forgetPhotos() {
        for (const url of photoUrls.values()) url.then((loaded) => loaded && URL.revokeObjectURL(loaded));
        photoUrls.clear();
      }

      function photoUrl(id: string) {
        if (!photoUrls.has(id)) {
          const loading = ask(`/api/inquiry-photos/${encodeURIComponent(id)}`)
            .then(async (response) => (response?.ok ? URL.createObjectURL(await response.blob()) : undefined))
            .catch(() => undefined);
          photoUrls.set(id, loading);
          // One that didn't load is asked for again next time.
          loading.then((loaded) => loaded || photoUrls.delete(id));
        }
        return photoUrls.get(id)!;
      }

      function photoFor(photo: InquiryPhoto, alt: string) {
        const figure = element("figure", "inquiry-photo");
        const caption = element("figcaption", undefined, photo.name);
        if ("missing" in photo) {
          figure.classList.add("inquiry-photo-missing");
          figure.append(element("p", undefined, "This photo couldn't be saved. It's still in the email."), caption);
          return figure;
        }
        const frame = element("div", "inquiry-photo-frame");
        figure.append(frame, caption);
        photoUrl(photo.id).then((url) => {
          if (!url) {
            frame.append(element("p", undefined, "This photo didn't load. Reload the page to try again."));
            return;
          }
          const image = element("img");
          image.alt = alt;
          image.src = url;
          frame.classList.add("is-loaded");
          frame.append(image);
        });
        return figure;
      }

      /** The id of the Inquiry the address opens, if it opens one. */
      const openedId = () => new URLSearchParams(location.search).get("inquiry");

      /** Shows what the address asks for: the list, or one Inquiry. */
      function showPage() {
        saveNotes();
        notesFor = undefined;
        const opened = openedId();
        back.hidden = !opened || !token;
        heading.textContent = "Inquiries";
        document.title = pageTitle;
        if (!token) return show("signed-out");
        if (!inquiries) return;

        if (!opened) return showList(inquiries);
        const inquiry = inquiryById(opened);
        if (inquiry) return showDetail(inquiry);
        show("nothing");
        showProblem("This Inquiry isn't here any more.");
      }

      /** A click that opens a link here, rather than in a new tab or window. */
      const opensHere = (event: MouseEvent) => !event.metaKey && !event.ctrlKey && !event.shiftKey && event.button === 0;

      // Opening an Inquiry and coming back stay on this page, and the list keeps its place.
      groups.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-inquiry]");
        if (!link || !opensHere(event)) return;
        event.preventDefault();
        history.replaceState({ scroll: scrollY }, "");
        history.pushState({ fromList: true }, "", link.href);
        showProblem();
        showPage();
        scrollTo(0, 0);
        heading.focus({ preventScroll: true });
      });

      // Coming from the list, going back returns to it where it was left. Opened straight from a link, it opens the list.
      back.addEventListener("click", (event) => {
        if (!opensHere(event)) return;
        event.preventDefault();
        if (history.state?.fromList) return history.back();
        history.pushState({}, "", back.href);
        showProblem();
        showPage();
      });

      addEventListener("popstate", () => {
        showProblem();
        showPage();
        scrollTo(0, history.state?.scroll ?? 0);
      });

      signInButton.addEventListener("click", async () => {
        showProblem();
        try {
          const signedIn = await signInWithGitHub();
          if (!signedIn) return;
          savedToken.save(signedIn);
          token = signedIn;
          await loadInquiries();
        } catch (error) {
          showProblem((error as Error).message);
        }
      });

      signOutButton.addEventListener("click", () => signOut());

      // The filter is kept in the address, so a reload, or coming back from an Inquiry, keeps it.
      for (const button of filterButtons) {
        button.addEventListener("click", () => {
          const url = new URL(location.href);
          if (button.dataset.status) url.searchParams.set("status", button.dataset.status);
          else url.searchParams.delete("status");
          history.replaceState(history.state, "", url);
          showList(inquiries ?? []);
          // Announced only when the owner chooses, not on load.
          const shown = groups.querySelectorAll(".inquiry-row").length;
          filterStatus.textContent = `Showing ${shown} ${shown === 1 ? "Inquiry" : "Inquiries"}`;
        });
      }

      heading.tabIndex = -1;
      token = savedToken.read();
      if (token) loadInquiries();
      else showPage();
    </script>
  </body>
</html>

