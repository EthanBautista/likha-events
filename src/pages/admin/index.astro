---
import "../../styles/tokens.css";
import AdminAppHead from "../../components/AdminAppHead.astro";
import { siteName } from "../../site-settings";

// The owner's editor page (ADR 0001): Sveltia CMS, bundled from npm so its version is pinned in
// package-lock.json. It loads its configuration from /admin/config.json. The editor has no place for
// a link of our own, so the link to the Inquiry dashboard floats in a corner its screens leave empty, above
// the bottom bar it shows on a phone.
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Editor · {siteName}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <AdminAppHead />
  </head>
  <body>
    <a class="inquiries-link" href="/admin/inquiries/">Inquiries</a>
    <script>
      import CMS from "@sveltia/cms";

      // The editor shows Cloudinary's photo picker in a pop-up with no close button of its own: only
      // the Escape key closes it, and a phone has none. So a Cancel button goes above the picker,
      // which sends the pop-up the same cancel event Escape does. The editor keeps the pop-up once
      // it has made it, so the button is added once.
      const observer = new MutationObserver(() => {
        const picker = document.querySelector("dialog > iframe#cloudinary-iframe");
        if (!picker) return;
        observer.disconnect();
        const cancel = document.createElement("button");
        cancel.type = "button";
        cancel.className = "picker-cancel";
        cancel.textContent = "Cancel";
        cancel.addEventListener("click", () => {
          picker.parentElement!.dispatchEvent(new Event("cancel", { cancelable: true }));
        });
        picker.before(cancel);
      });
      observer.observe(document.body, { childList: true, subtree: true });

      const response = await fetch("/admin/config.json");
      await CMS.init({ config: await response.json() });
    </script>
  </body>
</html>

<style>
  .inquiries-link {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 100vmax;
    background: var(--color-action);
    color: var(--color-on-action);
    border: 1px solid var(--color-on-action);
    /* The editor page loads no brand fonts, so the link takes the system's, like the editor around it. */
    font: 500 var(--text-sm) / 1 system-ui, sans-serif;
    text-decoration: none;
  }

  /* Below 768px the editor puts its page buttons in a 56px bar along the bottom, Contents first, on the
     left. The link sits above the bar, or it would cover that button and trap the owner on a page. */
  @media (width < 768px) {
    .inquiries-link {
      bottom: calc(56px + 1rem);
    }
  }

  .inquiries-link:hover {
    background: var(--color-action-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .inquiries-link {
      transition: background-color var(--duration-exit) ease-out;
    }
  }

  .inquiries-link:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 3px;
  }
</style>

<!-- Global, as the Cancel button and the picker are made by script, outside this page's markup. -->
<style is:global>
  dialog:has(> #cloudinary-iframe) {
    flex-direction: column;
    gap: 0.5rem;
  }

  /* The editor sizes the picker to fill the pop-up, less 16px a side; it gives up room for the button. */
  dialog > #cloudinary-iframe {
    height: calc(100% - 32px - 2.75rem - 0.5rem);
  }

  .picker-cancel {
    align-self: flex-end;
    margin-right: 16px;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 100vmax;
    background: var(--color-action);
    color: var(--color-on-action);
    border: 1px solid var(--color-on-action);
    font: 500 var(--text-sm) / 1 system-ui, sans-serif;
    cursor: pointer;
  }

  .picker-cancel:hover {
    background: var(--color-action-hover);
  }

  .picker-cancel:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 3px;
  }
</style>
