---
import SetupCard from "../components/SetupCard.astro";
import SetupViewer from "../components/SetupViewer.astro";
import { eventTypes } from "../event-types";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSetupsNewestFirst, type Setup } from "../setups";

const setups = await getSetupsNewestFirst();
const viewerId = (setup: Setup) => `setup-${setup.id}`;
---

<BaseLayout
  title="Gallery"
  description="Browse past Likha Events Setups for baby showers, birthdays and other events across the GTA."
>
  <section class="container gallery">
    <header class="intro">
      <h1>Gallery</h1>
      <p>Backdrops, balloon arches and dessert tables from past baby showers, birthdays and more.</p>
      <a class="pill pill-solid" href="/contact/">Get a quote</a>
    </header>

    <!-- Hidden until the script runs, so without JavaScript every Setup simply stays shown. -->
    <div class="filter" role="group" aria-label="Filter by Event type" hidden>
      <button type="button" class="pill" aria-pressed="true">All</button>
      {
        eventTypes.map((eventType) => (
          <button type="button" class="pill" aria-pressed="false" data-event-type={eventType}>
            {eventType}
          </button>
        ))
      }
    </div>
    <p class="filter-status visually-hidden" role="status"></p>

    <ul class="grid" aria-label="Setups">
      {
        setups.map((setup) => (
          <li data-event-type={setup.data.eventType}>
            <SetupCard setup={setup} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 90vw" />
            {/* Covers the whole card. */}
            <button type="button" class="open-viewer" aria-haspopup="dialog" commandfor={viewerId(setup)} command="show-modal">
              <span class="visually-hidden">See all photos: {setup.data.caption}</span>
            </button>
          </li>
        ))
      }
    </ul>

    {setups.map((setup) => <SetupViewer setup={setup} id={viewerId(setup)} />)}
  </section>
</BaseLayout>

<script>
  import { eventTypes, eventTypeSlug, type EventType } from "../event-types";

  const filter = document.querySelector<HTMLElement>(".filter")!;
  const buttons = [...filter.querySelectorAll<HTMLButtonElement>("button")];
  const setups = [...document.querySelectorAll<HTMLElement>(".grid > li")];
  const status = document.querySelector<HTMLElement>(".filter-status")!;
  // Read when each motion starts, so turning "reduce motion" on takes effect without a reload.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const settle = getComputedStyle(document.documentElement).getPropertyValue("--ease-settle");

  // Each card rises into place once, the first time it scrolls into view, while its photo settles into
  // the arch. Cards are shown by default and only start hidden once their animation runs, so the
  // Gallery never depends on this script to be seen.
  const reveal = (setup: HTMLElement, delay: number) => {
    if (reduceMotion.matches) return;
    const timing = { delay, easing: settle, fill: "backwards" } as const;
    setup.animate({ opacity: [0, 1], transform: ["translateY(1.5rem)", "none"] }, { ...timing, duration: 800 });
    setup.querySelector("img")?.animate({ transform: ["scale(1.06)", "none"] }, { ...timing, duration: 1400 });
  };
  // Cards arriving together are staggered, up to a short cap so a long row never keeps anyone waiting.
  const revealTogether = (arriving: HTMLElement[]) =>
    arriving.forEach((setup, index) => reveal(setup, Math.min(index, 4) * 90));

  const arrivals = new IntersectionObserver(
    (entries) => {
      const arriving = entries.filter((entry) => entry.isIntersecting).map((entry) => entry.target as HTMLElement);
      for (const setup of arriving) arrivals.unobserve(setup);
      revealTogether(arriving);
    },
    // Starts just before a card scrolls on screen, so it is already held back when it appears.
    { rootMargin: "0px 0px 10% 0px" },
  );

  // iPhones only show a card's pressed state (:active) when a touch listener is present.
  document.querySelector(".grid")!.addEventListener("touchstart", () => {}, { passive: true });

  const startRevealing = () => {
    if (reduceMotion.matches) return;
    // Cards already on screen start straight away, before the first observer callback, so they don't
    // flash in fully shown first.
    const onScreen = setups.filter((setup) => {
      const { top, bottom } = setup.getBoundingClientRect();
      return !setup.hidden && top < innerHeight && bottom > 0;
    });
    revealTogether(onScreen);
    for (const setup of setups) if (!onScreen.includes(setup)) arrivals.observe(setup);
  };

  // An undefined Event type means "All".
  const show = (eventType: EventType | undefined) => {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.eventType === eventType));
    }
    for (const setup of setups) {
      setup.hidden = eventType !== undefined && setup.dataset.eventType !== eventType;
    }
  };

  // Changing the Event type eases between results: cards that stay glide to their new places, and the
  // rest fade out or in. Browsers without View Transitions simply switch.
  const showWithTransition = (eventType: EventType | undefined, done: () => void) => {
    if (reduceMotion.matches || !document.startViewTransition) {
      show(eventType);
      done();
      return;
    }
    // From here the transition introduces the cards, so none waits to rise in on scroll. The names stay
    // set afterwards, ready for the next change.
    arrivals.disconnect();
    setups.forEach((setup, index) => (setup.style.viewTransitionName = `setup-${index}`));
    document.startViewTransition(() => {
      show(eventType);
      done();
    });
  };

  const eventTypeNamed = (name: string | undefined) => eventTypes.find((eventType) => eventType === name);

  // The chosen Event type is kept in the URL, so a filtered gallery can be shared or linked to.
  // An unknown value shows every Setup.
  const fromUrl = () => {
    const slug = new URLSearchParams(location.search).get("type");
    return eventTypes.find((eventType) => eventTypeSlug(eventType) === slug);
  };

  const choose = (eventType: EventType | undefined) => {
    const url = new URL(location.href);
    if (eventType) url.searchParams.set("type", eventTypeSlug(eventType));
    else url.searchParams.delete("type");
    history.replaceState(history.state, "", url);
    showWithTransition(eventType, () => {
      // Announced only when the visitor chooses, not on load.
      const shown = setups.filter((setup) => !setup.hidden).length;
      status.textContent = `Showing ${shown} ${shown === 1 ? "Setup" : "Setups"}`;
    });
  };

  filter.hidden = false;
  show(fromUrl());
  startRevealing();
  for (const button of buttons) {
    button.addEventListener("click", () => choose(eventTypeNamed(button.dataset.eventType)));
  }
</script>

<style>
  .gallery {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  .intro p {
    margin: 0 0 var(--space-md);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .filter[hidden] {
    display: none;
  }

  .grid > li {
    position: relative;
  }

  .open-viewer {
    position: absolute;
    inset: 0;
    padding: 0;
    border: none;
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
    background: transparent;
    cursor: pointer;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-xl) var(--space-lg);
  }

  /* The card answers a hover, or keyboard focus, by easing its photo closer inside the arch, and a
     press by settling back slightly. */
  @media (prefers-reduced-motion: no-preference) {
    .grid :global(.setup-card) {
      transition: scale 150ms ease-out;
    }

    .grid :global(.arch img) {
      transition: scale 900ms var(--ease-settle);
    }

    .grid > li:has(.open-viewer:focus-visible) :global(.arch img) {
      scale: 1.04;
    }

    .grid > li:has(.open-viewer:active) :global(.setup-card) {
      scale: 0.98;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .grid > li:has(.open-viewer:hover) :global(.arch img) {
      scale: 1.04;
    }
  }
</style>

<style is:global>
  /* Filtering by Event type, run as a View Transition (see the script). Only the cards move, so the
     rest of the page swaps without a cross-fade. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    /* Not blended together as in a cross-fade, which would wash the page out while the cards move. */
    mix-blend-mode: normal;
  }

  ::view-transition-group(*) {
    animation-duration: 550ms;
    animation-timing-function: var(--ease-settle);
  }

  /* A card leaving fades quickly; a card arriving fades and rises once the others have begun to move. */
  ::view-transition-old(*):only-child {
    animation: setup-leave 200ms ease-in both;
  }

  ::view-transition-new(*):only-child {
    animation: setup-arrive 550ms var(--ease-settle) 120ms both;
  }

  @keyframes setup-leave {
    to {
      opacity: 0;
    }
  }

  @keyframes setup-arrive {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
