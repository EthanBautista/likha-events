---
import SetupCard from "../components/SetupCard.astro";
import SetupViewer from "../components/SetupViewer.astro";
import { eventTypeSlug } from "../event-types";
import { getEventTypes } from "../event-types-list";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSetupsNewestFirst, type Setup } from "../setups";

const setups = await getSetupsNewestFirst();
const eventTypes = await getEventTypes();
const viewerId = (setup: Setup) => `setup-${setup.id}`;
---

<BaseLayout
  title="Gallery"
  description="Browse past Likha Events Setups for baby showers, birthdays and other events across the GTA."
>
  <section class="container gallery">
    <header class="intro">
      <h1>Gallery</h1>
      <p>Backdrops, balloon arches and dessert tables from past baby showers, birthdays and more.</p>
      <a class="pill pill-solid" href="/contact/">Get a quote</a>
    </header>

    <!-- Hidden until the script runs, so without JavaScript every Setup simply stays shown. -->
    <div class="filter" role="group" aria-label="Filter by Event type" hidden>
      <span class="highlight" aria-hidden="true"></span>
      <button type="button" class="pill" aria-pressed="true">All</button>
      {
        eventTypes.inGallery(setups).map((eventType) => (
          <button type="button" class="pill" aria-pressed="false" data-event-type={eventTypeSlug(eventType)}>
            {eventType}
          </button>
        ))
      }
    </div>
    <p class="filter-status visually-hidden" role="status"></p>

    <ul class="grid" aria-label="Setups">
      {
        setups.map((setup) => (
          <li data-event-type={eventTypeSlug(eventTypes.of(setup))}>
            <SetupCard setup={setup} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 90vw" />
            {/* Covers the whole card. */}
            <button type="button" class="open-viewer" aria-haspopup="dialog" commandfor={viewerId(setup)} command="show-modal">
              <span class="visually-hidden">See all photos: {setup.data.caption}</span>
            </button>
          </li>
        ))
      }
    </ul>

    {setups.map((setup) => <SetupViewer setup={setup} eventType={eventTypes.of(setup)} id={viewerId(setup)} />)}
  </section>
</BaseLayout>

<script>
  import { milliseconds, reduceMotion, revealOnScroll, riseWithPhoto, token } from "../motion";

  const filter = document.querySelector<HTMLElement>(".filter")!;
  const buttons = [...filter.querySelectorAll<HTMLButtonElement>("button")];
  const setups = [...document.querySelectorAll<HTMLElement>(".grid > li")];
  const status = document.querySelector<HTMLElement>(".filter-status")!;

  // The chosen Event type is marked by a highlight behind its button, which glides from one to the next.
  const highlight = filter.querySelector<HTMLElement>(".highlight")!;
  const placeHighlight = () => {
    const pressed = buttons.find((button) => button.getAttribute("aria-pressed") === "true")!;
    highlight.style.translate = `${pressed.offsetLeft}px ${pressed.offsetTop}px`;
    highlight.style.width = `${pressed.offsetWidth}px`;
    highlight.style.height = `${pressed.offsetHeight}px`;
  };

  // Event types are known here by their slugs, as in the URL. An undefined slug means "All".
  const show = (slug: string | undefined) => {
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.eventType === slug));
    }
    placeHighlight();
    for (const setup of setups) {
      setup.hidden = slug !== undefined && setup.dataset.eventType !== slug;
    }
  };

  const grid = document.querySelector<HTMLElement>(".grid")!;
  const glide = 550;
  const clearLeaving = (setup: HTMLElement) => {
    setup.classList.remove("leaving");
    setup.style.removeProperty("inset");
    setup.style.removeProperty("width");
  };

  // Changing the Event type eases between results: cards that stay glide to their new places, and the
  // rest fade out or in. Each change starts from wherever the cards are, so choosing again mid-way
  // carries on smoothly rather than jumping.
  const showWithMotion = (slug: string | undefined) => {
    if (reduceMotion.matches) {
      show(slug);
      return;
    }
    // From here these animations introduce the cards, so none waits to rise in on scroll.
    arrivals.stop();

    // Where each card on screen is now, and how faded, part-way through any change still running.
    const before = new Map(
      setups
        .filter((setup) => !setup.hidden)
        .map((setup) => [setup, { rect: setup.getBoundingClientRect(), opacity: getComputedStyle(setup).opacity }]),
    );
    for (const setup of setups) {
      for (const animation of setup.getAnimations()) animation.cancel();
      clearLeaving(setup);
    }

    show(slug);

    const gridRect = grid.getBoundingClientRect();
    for (const setup of setups) {
      const was = before.get(setup);
      if (was && !setup.hidden) {
        const { left, top } = setup.getBoundingClientRect();
        setup.animate(
          {
            transform: [`translate(${was.rect.left - left}px, ${was.rect.top - top}px)`, "none"],
            opacity: [was.opacity, "1"],
          },
          { duration: glide, easing: token("--ease-settle") },
        );
      } else if (was) {
        // Held where it was, out of the layout, while it fades; then hidden.
        setup.hidden = false;
        setup.classList.add("leaving");
        setup.style.inset = `${was.rect.top - gridRect.top}px auto auto ${was.rect.left - gridRect.left}px`;
        setup.style.width = `${was.rect.width}px`;
        setup
          .animate({ opacity: [was.opacity, "0"] }, { duration: milliseconds("--duration-exit"), easing: "ease-in" })
          .finished.then(() => {
            setup.hidden = true;
            clearLeaving(setup);
          })
          .catch(() => {});
      } else if (!setup.hidden) {
        // Arrives once the others have begun to move.
        setup.animate(
          { opacity: [0, 1], transform: ["translateY(1rem)", "none"] },
          { duration: glide, delay: 120, easing: token("--ease-settle"), fill: "backwards" },
        );
      }
    }
  };

  // The chosen Event type is kept in the URL, so a filtered gallery can be shared or linked to.
  // An unknown value, or one for an Event type without Setups, shows every Setup.
  const fromUrl = () => {
    const slug = new URLSearchParams(location.search).get("type");
    return buttons.find((button) => button.dataset.eventType === slug)?.dataset.eventType;
  };

  const choose = (slug: string | undefined) => {
    const url = new URL(location.href);
    if (slug) url.searchParams.set("type", slug);
    else url.searchParams.delete("type");
    history.replaceState(history.state, "", url);
    showWithMotion(slug);
    // Announced only when the visitor chooses, not on load.
    const shown = setups.filter((setup) => !setup.hidden && !setup.classList.contains("leaving")).length;
    status.textContent = `Showing ${shown} ${shown === 1 ? "Setup" : "Setups"}`;
  };

  filter.hidden = false;
  show(fromUrl());
  // Placed straight away on load, gliding only from then on. It follows its button as the buttons wrap
  // or the font loads.
  highlight.getBoundingClientRect();
  filter.classList.add("glides");
  const follow = new ResizeObserver(placeHighlight);
  for (const button of buttons) follow.observe(button);
  // Each card rises into place once, the first time it scrolls into view, while its photo settles into the arch.
  const arrivals = revealOnScroll(setups, riseWithPhoto);
  for (const button of buttons) {
    button.addEventListener("click", () => choose(button.dataset.eventType));
  }
</script>

<style>
  .gallery {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .intro {
    margin-bottom: var(--space-xl);
  }

  .intro p {
    margin: 0 0 var(--space-md);
  }

  .filter {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .filter[hidden] {
    display: none;
  }

  /* The pressed button's solid fill, drawn behind the buttons so it can glide between them (see the
     script). The buttons themselves stay clear, each label turning light as the highlight reaches it. */
  .highlight {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 100vmax;
    background: var(--color-action);
  }

  .filter .pill {
    position: relative;
  }

  .filter .pill[aria-pressed="true"] {
    background: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .filter.glides .highlight {
      transition:
        translate var(--duration-open) var(--ease-settle),
        width var(--duration-open) var(--ease-settle),
        height var(--duration-open) var(--ease-settle);
    }

    /* The hover tint goes at once rather than fading over the arriving highlight. */
    .filter .pill {
      transition:
        color var(--duration-exit) ease-out,
        scale var(--duration-press) ease-out;
    }
  }

  .grid > li {
    position: relative;
  }

  /* A card fading out after the Event type changes, held where it was (see the script). */
  .grid > li:global(.leaving) {
    position: absolute;
    pointer-events: none;
  }

  .open-viewer {
    position: absolute;
    inset: 0;
    padding: 0;
    border: none;
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
    background: transparent;
    cursor: pointer;
  }

  .grid {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-xl) var(--space-lg);
  }

  /* The card answers a hover, or keyboard focus, by easing its photo closer inside the arch, and a
     press by settling back slightly. */
  @media (prefers-reduced-motion: no-preference) {
    .grid :global(.setup-card) {
      transition: scale var(--duration-press) ease-out;
    }

    .grid :global(.arch img) {
      transition: scale var(--duration-linger) var(--ease-settle);
    }

    .grid > li:has(.open-viewer:focus-visible) :global(.arch img) {
      scale: 1.04;
    }

    .grid > li:has(.open-viewer:active) :global(.setup-card) {
      scale: 0.98;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .grid > li:has(.open-viewer:hover) :global(.arch img) {
      scale: 1.04;
    }
  }
</style>

