---
import PackageCard from "../components/PackageCard.astro";
import RentalCard from "../components/RentalCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatPrice,
  getLowestPackagePrice,
  getLowestWeddingPackagePrice,
  getPackagesInOrder,
  getWeddingPackagesInOrder,
} from "../packages";
import { getRentalsInOrder } from "../rentals";

const packages = await getPackagesInOrder();
const lowestPrice = await getLowestPackagePrice();
const weddingPackages = await getWeddingPackagesInOrder();
const lowestWeddingPrice = await getLowestWeddingPackagePrice();
const rentals = await getRentalsInOrder();
---

<BaseLayout
  title="Packages & Rentals"
  description="See Likha Events décor Packages and Rentals for your event, plus how booking works."
>
  <section class="container packages" aria-labelledby="packages-heading">
    <h1>Packages & Rentals</h1>
    <h2 id="packages-heading">{lowestPrice === undefined ? "Packages" : `Packages from ${formatPrice(lowestPrice)}`}</h2>
    {
      packages.length > 0 ? (
        <p class="lead">
          Compare what each Package includes. Planning something bigger or different?{" "}
          <a href="/contact/">Message us for a custom quote</a>.
        </p>
      ) : (
        <p class="lead">
          Tell us about your event and <a href="/contact/">message us for a custom quote</a>.
        </p>
      )
    }

    {
      packages.length > 0 && (
        <ul class="grid" aria-label="Packages">
          {packages.map((pkg) => (
            <li>
              <PackageCard pkg={pkg} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    lowestWeddingPrice !== undefined && (
      <section class="container wedding-packages" aria-labelledby="wedding-packages-heading">
        <h2 id="wedding-packages-heading">Wedding Packages from {formatPrice(lowestWeddingPrice)}</h2>
        <p class="lead">
          Décor for your ceremony and reception, designed and set up for the day.{" "}
          <a href="/contact/?type=wedding">Ask about a Wedding Package</a>.
        </p>
        <ul class="grid" aria-label="Wedding Packages">
          {weddingPackages.map((pkg) => (
            <li>
              <PackageCard pkg={pkg} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    rentals.length > 0 && (
      <section class="container rentals" aria-labelledby="rentals-heading">
        <h2 id="rentals-heading">Rentals</h2>
        <p class="lead">
          Rent a single piece and style it yourself, no Package needed. <a href="/contact/">Ask us about a Rental</a>.
        </p>
        <ul class="rental-grid" aria-label="Rentals">
          {rentals.map((rental) => (
            <li>
              <RentalCard rental={rental} sizes="(min-width: 60rem) 16rem, (min-width: 30rem) 45vw, 90vw" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="booking" aria-labelledby="booking-heading">
    <div class="container">
      <h2 id="booking-heading">How booking works</h2>
      <ol class="steps">
        <li>
          <h3>Send an inquiry</h3>
          <p>Tell us your event date, venue and the look you're after.</p>
        </li>
        <li>
          <h3>Get your quote</h3>
          <p>We reply with a quote based on your Package or custom ideas.</p>
        </li>
        <li>
          <h3>Hold your date</h3>
          <p>A 50% non-refundable Down payment holds your date.</p>
        </li>
      </ol>
      <p class="travel">
        Based in North York, serving the whole GTA. A travel fee applies to events outside the GTA.
      </p>
      <a class="pill pill-solid" href="/contact/">Send an inquiry</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { revealOnScroll, rise, riseWithPhoto } from "../motion";

  // Each Package, Wedding Package, Rental and booking step rises softly into view the first time it is
  // scrolled to, those arriving together one after another. Rentals arrive like the Gallery's cards,
  // their photos settling into the arch.
  const main = document.querySelector("main")!;
  const elements = (selector: string) => [...main.querySelectorAll<HTMLElement>(selector)];
  revealOnScroll(elements(".grid > li"), rise);
  revealOnScroll(elements(".rental-grid > li"), riseWithPhoto);
  revealOnScroll(elements(".steps > li, .travel, .booking .pill"), rise);
</script>

<style>
  .packages {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  h2 {
    margin: var(--space-lg) 0 var(--space-sm);
  }

  .lead {
    margin: 0 0 var(--space-xl);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg);
  }

  .wedding-packages,
  .rentals {
    padding-block: 0 var(--space-2xl);
  }

  .wedding-packages h2,
  .rentals h2 {
    margin-top: 0;
  }

  .rental-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-lg);
  }

  /* The page ends on this band, so it runs down to the sage footer, a hairline between them, rather than
     leaving a strip of paper in the footer's gap. */
  .booking {
    margin-bottom: calc(-1 * var(--space-2xl));
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-sage-band);
  }

  .booking h2 {
    margin: 0 0 var(--space-lg);
  }

  .steps {
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-lg);
  }

  .steps li {
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-sm);
    border-radius: 50%;
    background: var(--color-action);
    color: var(--color-on-action);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .steps h3 {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-lg);
  }

  .steps p {
    margin: 0;
  }

  .travel {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
  }

</style>
