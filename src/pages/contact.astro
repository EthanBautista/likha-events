---
import SocialIcon from "../components/SocialIcon.astro";
import { eventTypes } from "../event-types";
import BaseLayout from "../layouts/BaseLayout.astro";
import { social } from "../site-settings";

const maxPhotos = 3;
// Netlify Forms takes one file per field, so each photo is sent in its own field.
const photoFields = Array.from({ length: maxPhotos }, (_, index) => `inspiration-photo-${index + 1}`);
---

<BaseLayout
  title="Contact"
  description="Send Likha Events an inquiry about decorations for your event and get a quote."
>
  <section class="container contact">
    <header class="intro">
      <h1>Contact</h1>
      <p>
        Tell us about your event and we'll send you a quote. Fields marked optional can wait if you haven't
        decided yet.
      </p>
    </header>

    <!--
      A Netlify Form: Netlify finds it in the built HTML and stores each Inquiry. Bots fill in the
      hidden bot-field, and Netlify drops any Inquiry that has it.
    -->
    <form
      class="inquiry"
      name="inquiry"
      aria-label="Inquiry"
      method="post"
      enctype="multipart/form-data"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="inquiry" />
      <p hidden>
        <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <!-- data-missing is the message shown in place of the browser's own when the field is left empty. -->
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" autocomplete="name" required data-missing="Please enter your name." />
      </div>

      <div class="field">
        <label for="contact">Phone number or email</label>
        <input
          id="contact"
          name="contact"
          required
          data-missing="Please enter a phone number or email so we can reply."
        />
      </div>

      <div class="field">
        <label for="event-date">Event date</label>
        <input
          id="event-date"
          name="event-date"
          type="date"
          required
          data-missing="Please choose the date of your event."
        />
      </div>

      <div class="field">
        <label for="venue">Venue or city</label>
        <input id="venue" name="venue" required data-missing="Please enter the venue or city." />
      </div>

      <div class="field">
        <label for="event-type">Event type</label>
        <select id="event-type" name="event-type" required data-missing="Please choose an Event type.">
          <option value="">Choose one</option>
          {eventTypes.map((eventType) => <option>{eventType}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="guests">Number of guests <span class="optional">(optional)</span></label>
        <input id="guests" name="guests" type="number" min="1" inputmode="numeric" />
      </div>

      <div class="field">
        <label for="theme">Theme or colours <span class="optional">(optional)</span></label>
        <input id="theme" name="theme" />
      </div>

      <div class="field">
        <label for="decor">Décor wanted <span class="optional">(optional)</span></label>
        <textarea id="decor" name="decor" rows="4"></textarea>
      </div>

      <!--
        Visitors pick all their photos in the first field. The script below sends each one in its own
        field; the hidden fields are here so Netlify knows about them when it reads the form at build time.
      -->
      <div class="field">
        <label for="photos">Inspiration photos <span class="optional">(optional)</span></label>
        <p class="hint" id="photos-hint">Up to {maxPhotos} images of the look you're after.</p>
        <input
          id="photos"
          name={photoFields[0]}
          type="file"
          accept="image/*"
          multiple
          data-max={maxPhotos}
          aria-describedby="photos-hint photos-error"
        />
        <p class="error" id="photos-error" aria-live="polite"></p>
        {photoFields.slice(1).map((name) => <input type="file" name={name} accept="image/*" hidden />)}
      </div>

      <button class="send" type="submit">Send inquiry</button>
    </form>

    <aside class="chat" aria-labelledby="chat-heading">
      <h2 id="chat-heading">Prefer to chat?</h2>
      <p>Send us a message on Instagram or Facebook instead.</p>
      <ul>
        <li>
          <a class="chat-button" href={social.instagram}>
            <SocialIcon network="instagram" />
            Message us on Instagram
          </a>
        </li>
        <li>
          <a class="chat-button" href={social.facebook}>
            <SocialIcon network="facebook" />
            Message us on Facebook
          </a>
        </li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<script>
  const fields = document.querySelectorAll<HTMLInputElement | HTMLSelectElement>(".inquiry [data-missing]");

  for (const field of fields) {
    field.addEventListener("invalid", () => {
      if (field.validity.valueMissing) field.setCustomValidity(field.dataset.missing!);
    });
    // Clear the message once the visitor answers, so the browser checks the field afresh.
    for (const type of ["input", "change"]) {
      field.addEventListener(type, () => field.setCustomValidity(""));
    }
  }

  const form = document.querySelector<HTMLFormElement>(".inquiry")!;
  const photos = document.querySelector<HTMLInputElement>("#photos")!;
  const photosError = document.querySelector<HTMLElement>("#photos-error")!;
  const maxPhotos = Number(photos.dataset.max);
  const photoFields = [...form.querySelectorAll<HTMLInputElement>('input[type="file"]')].map((input) => input.name);

  // Some phones leave out the type of photos such as HEIC, so fall back to the file name.
  const isImage = (file: File) =>
    file.type ? file.type.startsWith("image/") : /\.(jpe?g|png|gif|webp|heic|heif|avif)$/i.test(file.name);

  // The picker only offers images, but a visitor can still drop in any file, so check what they chose.
  photos.addEventListener("change", () => {
    const chosen = [...(photos.files ?? [])];
    const notImage = chosen.find((file) => !isImage(file));
    let message = "";
    if (chosen.length > maxPhotos) {
      message = `Please choose up to ${maxPhotos} photos. You chose ${chosen.length}.`;
    } else if (notImage) {
      message = `"${notImage.name}" isn't an image. Please choose photos only.`;
    }
    photos.setCustomValidity(message);
    photosError.textContent = message;
  });

  // Send each chosen photo in a field of its own, as Netlify Forms takes one file per field.
  form.addEventListener("formdata", (event) => {
    for (const name of photoFields) event.formData.delete(name);
    [...(photos.files ?? [])].forEach((file, index) => event.formData.append(photoFields[index], file));
  });
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .intro p {
    margin: 0;
  }

  .inquiry {
    display: grid;
    gap: var(--space-md);
    max-width: 34rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  label {
    font-weight: 500;
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .hint,
  .error {
    margin: 0;
    font-size: var(--text-sm);
  }

  .hint {
    color: var(--color-text-muted);
  }

  .error {
    color: var(--color-error);
  }

  .error:empty {
    display: none;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-text);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  .send {
    justify-self: start;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-lg);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-action);
    color: var(--color-on-action);
    font: inherit;
    cursor: pointer;
  }

  .send:hover {
    background: var(--color-action-hover);
  }

  .chat {
    align-self: start;
    padding: var(--space-lg);
    border-radius: var(--radius);
    background: var(--color-sage-band);
  }

  .chat h2 {
    margin: 0 0 var(--space-xs);
  }

  .chat p {
    margin: 0 0 var(--space-md);
  }

  .chat ul {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chat-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-md);
    border: 1px solid var(--color-action);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .chat-button:hover {
    background: var(--color-action);
    color: var(--color-on-action);
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 34rem) minmax(0, 22rem);
      justify-content: space-between;
    }

    .intro {
      grid-column: 1 / -1;
    }
  }
</style>
