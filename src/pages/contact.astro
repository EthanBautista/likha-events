---
import SocialIcon from "../components/SocialIcon.astro";
import { eventTypeSlug } from "../event-types";
import { getEventTypes } from "../event-types-list";
import BaseLayout from "../layouts/BaseLayout.astro";
import { social } from "../site-settings";

const eventTypes = await getEventTypes();
const maxPhotos = 3;
// Netlify Forms takes one file per field, so each photo is sent in its own field.
const photoFields = Array.from({ length: maxPhotos }, (_, index) => `inspiration-photo-${index + 1}`);
---

<BaseLayout
  title="Contact"
  description="Send Likha Events an inquiry about decorations for your event and get a quote."
>
  <section class="container contact">
    <header class="intro">
      <h1>Contact</h1>
      <p>
        Tell us about your event and we'll send you a quote. Fields marked optional can wait if you haven't
        decided yet.
      </p>
    </header>

    <!--
      A Netlify Form: Netlify finds it in the built HTML and stores each Inquiry. Bots fill in the
      hidden bot-field, and Netlify drops any Inquiry that has it.
    -->
    <form
      class="inquiry"
      name="inquiry"
      aria-label="Inquiry"
      method="post"
      enctype="multipart/form-data"
      action="/contact/thanks/"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="inquiry" />
      <p hidden>
        <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>

      <!--
        Each field's message shows in the "-error" line under it, in place of the browser's own popup.
        data-missing is the message when the field is left empty, and data-invalid when it is filled in wrongly.
      -->
      <div class="field">
        <label for="name">Your name</label>
        <input
          id="name"
          name="name"
          autocomplete="name"
          required
          data-missing="Please enter your name."
          aria-describedby="name-error"
        />
        <p class="error" id="name-error"></p>
      </div>

      <div class="field">
        <label for="contact">Phone number or email</label>
        <input
          id="contact"
          name="contact"
          required
          data-missing="Please enter a phone number or email so we can reply."
          aria-describedby="contact-error"
        />
        <p class="error" id="contact-error"></p>
      </div>

      <div class="field">
        <label for="event-date">Event date</label>
        <input
          id="event-date"
          name="event-date"
          type="date"
          required
          data-missing="Please choose the date of your event."
          aria-describedby="event-date-error"
        />
        <p class="error" id="event-date-error"></p>
      </div>

      <div class="field">
        <label for="venue">Venue or city</label>
        <input
          id="venue"
          name="venue"
          required
          data-missing="Please enter the venue or city."
          aria-describedby="venue-error"
        />
        <p class="error" id="venue-error"></p>
      </div>

      <div class="field">
        <label for="event-type">Event type</label>
        <select
          id="event-type"
          name="event-type"
          required
          data-missing="Please choose an Event type."
          aria-describedby="event-type-error"
        >
          <option value="">Choose one</option>
          {eventTypes.all.map((eventType) => <option data-event-type={eventTypeSlug(eventType)}>{eventType}</option>)}
        </select>
        <p class="error" id="event-type-error"></p>
      </div>

      <div class="field">
        <label for="guests">Number of guests <span class="optional">(optional)</span></label>
        <input
          id="guests"
          name="guests"
          type="number"
          min="1"
          inputmode="numeric"
          data-invalid="Please enter the number of guests as a whole number, like 40."
          aria-describedby="guests-error"
        />
        <p class="error" id="guests-error"></p>
      </div>

      <div class="field">
        <label for="theme">Theme or colours <span class="optional">(optional)</span></label>
        <input id="theme" name="theme" />
      </div>

      <div class="field">
        <label for="decor">Décor wanted <span class="optional">(optional)</span></label>
        <textarea id="decor" name="decor" rows="4"></textarea>
      </div>

      <!--
        Visitors pick all their photos in the first field. The script below sends each one in its own
        field; the hidden fields are here so Netlify knows about them when it reads the form at build time.
      -->
      <div class="field">
        <label for="photos">Inspiration photos <span class="optional">(optional)</span></label>
        <p class="hint" id="photos-hint">Up to {maxPhotos} images of the look you're after.</p>
        <input
          id="photos"
          name={photoFields[0]}
          type="file"
          accept="image/*"
          multiple
          data-max={maxPhotos}
          aria-describedby="photos-hint photos-error"
        />
        <p class="error" id="photos-error" aria-live="polite"></p>
        {photoFields.slice(1).map((name) => <input type="file" name={name} accept="image/*" hidden />)}
      </div>

      <div class="send-row">
        <button class="pill pill-solid send" type="submit">
          <svg class="sending-arc" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="10" cy="10" r="8" pathLength="100" />
          </svg>
          <span class="send-label">Send inquiry</span>
        </button>
        <p class="visually-hidden" role="status"></p>
      </div>
    </form>

    <aside class="chat" aria-labelledby="chat-heading">
      <h2 id="chat-heading">Prefer to chat?</h2>
      <p>Send us a message on Instagram or Facebook instead.</p>
      <ul>
        <li>
          <a class="pill chat-button" href={social.instagram}>
            <SocialIcon network="instagram" />
            Message us on Instagram
          </a>
        </li>
        <li>
          <a class="pill chat-button" href={social.facebook}>
            <SocialIcon network="facebook" />
            Message us on Facebook
          </a>
        </li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<script>
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>(".inquiry")!;
  const photos = document.querySelector<HTMLInputElement>("#photos")!;
  const maxPhotos = Number(photos.dataset.max);

  // Shows the message in the line under the field, or clears it when the message is empty.
  const showError = (field: Field, message: string) => {
    document.getElementById(`${field.id}-error`)!.textContent = message;
    if (message) field.setAttribute("aria-invalid", "true");
    else field.removeAttribute("aria-invalid");
  };

  // When sending finds a problem, each field with one says what it needs under it, and the first is focused.
  // The browser's own popup is held back, and with it the browser's focusing, so the script focuses instead.
  let focusedFirst = false;
  form.addEventListener(
    "invalid",
    (event) => {
      const field = event.target as Field;
      event.preventDefault();
      const { missing, invalid } = field.dataset;
      if (field.validity.valueMissing && missing) field.setCustomValidity(missing);
      else if (!field.validity.customError && invalid) field.setCustomValidity(invalid);
      showError(field, field.validationMessage);
      if (!focusedFirst) {
        focusedFirst = true;
        field.focus();
        // Every field is checked in one go, so the next attempt focuses afresh.
        setTimeout(() => (focusedFirst = false));
      }
    },
    // "invalid" doesn't bubble.
    { capture: true },
  );

  // Once the visitor answers, the browser checks the field afresh, and its message goes when it's right.
  for (const type of ["input", "change"]) {
    form.addEventListener(type, (event) => {
      const field = event.target as Field;
      if (field.dataset.missing || field.dataset.invalid) field.setCustomValidity("");
      if (field.validity.valid && field.hasAttribute("aria-invalid")) showError(field, "");
    });
  }
  // A link can choose the Event type, written as in the gallery's filter, such as `?type=wedding`. An unknown
  // one leaves "Choose one".
  const linkedType = new URLSearchParams(location.search).get("type");
  const linkedOption = [...form.querySelectorAll<HTMLOptionElement>("#event-type option")].find(
    (option) => option.dataset.eventType === linkedType,
  );
  if (linkedOption) linkedOption.selected = true;

  const photoFields = [...form.querySelectorAll<HTMLInputElement>('input[type="file"]')].map((input) => input.name);

  // Some phones leave out the type of photos such as HEIC, so fall back to the file name.
  const isImage = (file: File) =>
    file.type ? file.type.startsWith("image/") : /\.(jpe?g|png|gif|webp|heic|heif|avif)$/i.test(file.name);

  // The picker only offers images, but a visitor can still drop in any file, so check what they chose.
  photos.addEventListener("change", () => {
    const chosen = [...(photos.files ?? [])];
    const notImage = chosen.find((file) => !isImage(file));
    let message = "";
    if (chosen.length > maxPhotos) {
      message = `Please choose up to ${maxPhotos} photos. You chose ${chosen.length}.`;
    } else if (notImage) {
      message = `"${notImage.name}" isn't an image. Please choose photos only.`;
    }
    photos.setCustomValidity(message);
    showError(photos, message);
  });

  // While the Inquiry and its photos are on their way, which can take a while on mobile data, the button
  // says so and another press sends nothing more.
  const send = form.querySelector<HTMLButtonElement>(".send")!;
  const sendLabel = send.querySelector<HTMLElement>(".send-label")!;
  const sendStatus = form.querySelector<HTMLElement>('[role="status"]')!;
  const idleLabel = sendLabel.textContent!;
  const sendingLabel = "Sending your inquiry…";
  let sending = false;

  const showSending = (isSending: boolean) => {
    sending = isSending;
    send.toggleAttribute("data-sending", isSending);
    if (isSending) send.setAttribute("aria-disabled", "true");
    else send.removeAttribute("aria-disabled");
    sendLabel.textContent = isSending ? sendingLabel : idleLabel;
    sendStatus.textContent = isSending ? sendingLabel : "";
  };

  form.addEventListener("submit", (event) => {
    if (sending) event.preventDefault();
    else showSending(true);
  });

  // Coming back to the page from the thank-you page, the form is ready to send again.
  addEventListener("pageshow", (event) => {
    if (event.persisted) showSending(false);
  });

  // Send each chosen photo in a field of its own, as Netlify Forms takes one file per field.
  form.addEventListener("formdata", (event) => {
    for (const name of photoFields) event.formData.delete(name);
    [...(photos.files ?? [])].forEach((file, index) => event.formData.append(photoFields[index], file));
  });
</script>

<style>
  .contact {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .intro p {
    margin: 0;
  }

  .inquiry {
    display: grid;
    gap: var(--space-md);
    max-width: 34rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  label {
    font-weight: 500;
  }

  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .hint,
  .error {
    margin: 0;
    font-size: var(--text-sm);
  }

  .hint {
    color: var(--color-text-muted);
  }

  .error {
    color: var(--color-error);
  }

  .error:empty {
    display: none;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-text);
    font: inherit;
    caret-color: var(--color-action);
  }

  /* The border deepens to forest under the pointer and while typing, and turns brick while the field
     has a message under it. */
  input:hover,
  select:hover,
  textarea:hover,
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-action);
  }

  [aria-invalid="true"] {
    border-color: var(--color-error);
  }

  textarea {
    resize: vertical;
  }

  /* The photo picker's own button, as a small outline pill. */
  input[type="file"] {
    padding-block: 0.3125rem;
    cursor: pointer;
  }

  input[type="file"]::file-selector-button {
    margin-right: var(--space-sm);
    padding: 0.25rem var(--space-sm);
    border: 1px solid var(--color-action);
    border-radius: 100vmax;
    background: transparent;
    color: var(--color-action);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  input[type="file"]:hover::file-selector-button {
    background: var(--color-sage-band);
  }

  .send-row {
    margin-top: var(--space-xs);
  }

  .send {
    gap: var(--space-xs);
    padding-inline: var(--space-lg);
  }

  /* While sending, a thin arc turns before the label. It takes no room until then, and under "reduce motion"
     the label alone says it is sending. */
  .sending-arc {
    display: none;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 30 70;
  }

  /* While sending it no longer darkens or settles back, so it doesn't look ready for another press. */
  .send[data-sending],
  .send[data-sending]:hover {
    background: var(--color-action);
    cursor: progress;
  }

  .send[data-sending]:active {
    scale: none;
  }

  .chat {
    align-self: start;
    padding: var(--space-lg);
    border-radius: var(--radius);
    background: var(--color-sage-band);
  }

  .chat h2 {
    margin: 0 0 var(--space-xs);
  }

  .chat p {
    margin: 0 0 var(--space-md);
  }

  .chat ul {
    display: grid;
    justify-items: start;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chat-button {
    gap: var(--space-xs);
  }

  /* On the sage band an outline pill fills with paper, so it still lifts on hover. */
  .chat-button:hover {
    background: var(--color-bg);
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 34rem) minmax(0, 22rem);
      justify-content: space-between;
    }

    .intro {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    input,
    select,
    textarea {
      transition: border-color var(--duration-exit) ease-out;
    }

    input[type="file"]::file-selector-button {
      transition: background-color var(--duration-exit) ease-out;
    }

    /* A message eases in just under its field, rather than popping in. */
    .error:not(:empty) {
      animation: error-in var(--duration-open) var(--ease-settle);
    }

    .send[data-sending] .sending-arc {
      display: block;
      animation:
        arc-in var(--duration-exit) ease-out,
        arc-turn var(--duration-turn) linear infinite;
    }
  }

  @keyframes error-in {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
  }

  @keyframes arc-in {
    from {
      opacity: 0;
    }
  }

  @keyframes arc-turn {
    to {
      rotate: 1turn;
    }
  }
</style>
